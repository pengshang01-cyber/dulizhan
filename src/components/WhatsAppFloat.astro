---
import { getWhatsAppHref, site } from "../config/site";
import BrandIcon from "./BrandIcon.astro";

const href = getWhatsAppHref(site.whatsappNumber, site.whatsappPrefillMessage);
---

{href && (
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat on WhatsApp"
    data-track="whatsapp_click"
    class="fixed right-4 bottom-4 z-30 grid size-13 place-items-center rounded-full bg-secondary-ink text-white shadow-panel transition-colors hover:bg-footer motion-reduce:transition-none sm:right-6 sm:bottom-6"
  >
    <BrandIcon name="whatsapp" class="size-6" />
  </a>
)}
