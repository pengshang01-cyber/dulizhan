---
import { localePath } from "../../i18n/routing";
import type { Locale } from "../../i18n/utils";
import FaqAccordion from "../FaqAccordion.astro";
import AddToInquiryButton from "../AddToInquiryButton.astro";
import Breadcrumbs from "../Breadcrumbs.astro";
import Button from "../Button.astro";
import Container from "../Container.astro";
import Eyebrow from "../Eyebrow.astro";
import ProductCard from "../ProductCard.astro";
import ProductGallery from "../ProductGallery.astro";
import SectionHeading from "../SectionHeading.astro";
import { display } from "../../config/site";
import { localized, t } from "../../i18n/utils";
import {
  getProductCategory,
  measurementLabel,
  type Product,
} from "../../lib/products";
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Props {
  locale?: Locale;
  product: Product;
  related: Product[];
}
const { product, related } = Astro.props;
const { data } = product;
const { locale = "en" } = Astro.props;
const category = await getProductCategory(data.category);
const categoryLabel = localized(category.label, locale);
const title = display(
  localized(data.title, locale),
  t("products.todo.name", locale),
);
const summary = display(
  localized(data.summary, locale),
  t("products.todo.summary", locale),
);
const specificationRows = [
  [
    t("products.material", locale),
    display(
      localized(data.material, locale),
      t("products.todo.material", locale),
    ),
  ],
  [
    t("products.paperWeight", locale),
    typeof data.gsm === "number"
      ? t("products.weightValue", locale, { value: data.gsm })
      : display(data.gsm, t("products.todo.paperWeight", locale)),
  ],
  [
    t("products.minimumOrder", locale),
    display(
      localized(data.moq, locale),
      t("products.todo.minimumOrder", locale),
    ),
  ],
  [
    t("products.packaging", locale),
    display(
      localized(data.packaging, locale),
      t("products.todo.packaging", locale),
    ),
  ],
  [
    t("products.cartonSpecification", locale),
    display(
      localized(data.cartonSpec, locale),
      t("products.todo.cartonSpecification", locale),
    ),
  ],
  [
    t("products.leadTime", locale),
    display(
      localized(data.leadTime, locale),
      t("products.todo.leadTime", locale),
    ),
  ],
];
const customization =
  typeof data.customizable === "boolean"
    ? t(
        data.customizable
          ? "products.customizationAvailable"
          : "products.customizationUnavailable",
        locale,
      )
    : display(data.customizable, t("products.todo.customization", locale));
const bodySections = [
  {
    heading: t("products.customOptions", locale),
    value: data.customOptions,
    label: t("products.todo.customOptions", locale),
  },
  {
    heading: t("products.packaging", locale),
    value: data.packagingDetails,
    label: t("products.todo.packagingDetails", locale),
  },
  {
    heading: t("products.applications", locale),
    value: data.applications,
    label: t("products.todo.applications", locale),
  },
].filter(({ value }) => value && String(localized(value, locale)).trim());
---

<BaseLayout
  locale={locale}
  title={String(
    display(
      localized(data.seoTitle ?? data.title, locale),
      t("products.todo.title", locale),
    ),
  )}
  description={String(
    display(
      localized(data.seoDescription ?? data.summary, locale),
      t("products.todo.description", locale),
    ),
  )}
>
  <Container class="py-8 sm:py-12">
    <Breadcrumbs
      locale={locale}
      items={[
        { label: t("breadcrumbs.home", locale), href: "/" },
        { label: t("breadcrumbs.products", locale), href: "/products/" },
        { label: categoryLabel, href: "/products/" + category.id + "/" },
        { label: title },
      ]}
    />

    <section
      class="mt-8 grid items-start gap-8 lg:grid-cols-2 lg:gap-12"
      aria-labelledby="product-title"
    >
      <ProductGallery locale={locale} images={data.images} title={title} />
      <div class="min-w-0 lg:py-3">
        <Eyebrow>{categoryLabel}</Eyebrow>
        <h1
          id="product-title"
          class="mt-5 font-display text-page-title font-normal wrap-anywhere"
        >
          {title}
        </h1>
        <p class="mt-4 text-xs font-semibold tracking-[0.12em] wrap-anywhere text-muted uppercase">
          {t("products.skuPrefix", locale)}{" "}
          {display(data.sku, t("products.sku", locale))}
        </p>
        <p class="mt-6 text-base leading-relaxed text-ink-soft">{summary}</p>
        <p class="mt-7 text-xs font-extrabold tracking-[0.14em] text-copper uppercase">
          {t("products.askPricing", locale)}
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <Button
            href={localePath(
              "/contact/?product=" + encodeURIComponent(data.slug) + "#quote",
              locale,
            )}
          >
            {t("products.getQuote", locale)}
          </Button>
          <AddToInquiryButton
            locale={locale}
            product={{
              slug: data.slug,
              sku: data.sku,
              title: localized(data.title, locale),
              category: data.category,
            }}
            class="min-h-12 px-5"
          />
        </div>
        <p class="mt-5 text-sm leading-relaxed text-ink-soft">
          {t("products.inquiryHelp", locale)}
        </p>
      </div>
    </section>

    <section
      class="mt-14 border-t border-line pt-10 sm:mt-20"
      aria-labelledby="specifications-title"
    >
      <SectionHeading
        eyebrow={t("products.detailsEyebrow", locale)}
        title={t("products.specifications", locale)}
        id="specifications-title"
      />
      <dl class="mt-7 grid gap-px overflow-hidden rounded-panel border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        {specificationRows.map(([label, value]) => (
          <div class="min-w-0 bg-white p-5">
            <dt class="text-[0.6875rem] font-bold tracking-[0.1em] text-ink-soft uppercase">
              {label}
            </dt>
            <dd class="mt-2 text-sm leading-relaxed wrap-anywhere">{value}</dd>
          </div>
        ))}
      </dl>
      <h3 class="mt-8 font-display text-card-title font-normal">
        {t("products.sizes", locale)}
      </h3>
      <div
        data-size-table
        role="region"
        aria-label={t("products.sizeRegion", locale)}
        tabindex="0"
        class="mt-4 max-w-full overflow-x-auto rounded-panel border border-line bg-white"
      >
        <table class="w-full min-w-[42rem] border-collapse text-left text-sm">
          <caption class="sr-only">
            {t("products.dimensionsCaption", locale)}
          </caption>
          <thead class="border-b border-line bg-paper text-xs text-ink-soft">
            <tr>
              <th scope="col" class="px-5 py-4 font-bold">
                {t("products.size", locale)}
              </th>
              <th scope="col" class="px-5 py-4 font-bold">
                {t("products.baseDiameter", locale)}
              </th>
              <th scope="col" class="px-5 py-4 font-bold">
                {t("products.height", locale)}
              </th>
              <th scope="col" class="px-5 py-4 font-bold">
                {t("products.topDiameter", locale)}
              </th>
            </tr>
          </thead>
          <tbody>
            {data.sizes.map((size) => (
              <tr class="border-b border-line last:border-b-0">
                <th scope="row" class="px-5 py-4 font-semibold">
                  {display(
                    localized(size.name, locale),
                    t("products.todo.sizeName", locale),
                  )}
                </th>
                <td class="px-5 py-4">
                  {measurementLabel(
                    size.baseDiameterMm,
                    t("products.todo.baseDiameter", locale),
                    locale,
                  )}
                </td>
                <td class="px-5 py-4">
                  {measurementLabel(
                    size.heightMm,
                    t("products.todo.height", locale),
                    locale,
                  )}
                </td>
                <td class="px-5 py-4">
                  {measurementLabel(
                    size.topDiameterMm,
                    t("products.todo.topDiameter", locale),
                    locale,
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section
      class="mt-10 grid gap-5 sm:grid-cols-3"
      aria-label={t("products.availableOptions", locale)}
    >
      <div class="min-w-0 rounded-panel border border-line bg-white p-5">
        <h2 class="font-display text-card-title font-normal">
          {t("products.colors", locale)}
        </h2>
        <ul class="mt-3 grid gap-2 text-sm leading-relaxed text-ink-soft">
          {data.colors.map((color) => (
            <li>
              {display(
                localized(color, locale),
                t("products.todo.colors", locale),
              )}
            </li>
          ))}
        </ul>
      </div>
      <div class="min-w-0 rounded-panel border border-line bg-white p-5">
        <h2 class="font-display text-card-title font-normal">
          {t("products.patterns", locale)}
        </h2>
        <ul class="mt-3 grid gap-2 text-sm leading-relaxed text-ink-soft">
          {data.patterns.map((pattern) => (
            <li>
              {display(
                localized(pattern, locale),
                t("products.todo.patterns", locale),
              )}
            </li>
          ))}
        </ul>
      </div>
      <div class="min-w-0 rounded-panel border border-line bg-white p-5">
        <h2 class="font-display text-card-title font-normal">
          {t("products.customization", locale)}
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft">
          {customization}
        </p>
      </div>
    </section>

    {bodySections.length > 0 && (
      <div class="product-body mt-10 max-w-3xl border-t border-line pt-2">
        {bodySections.map(({ heading, value, label }) => (
          <section>
            <h2>{heading}</h2>
            <p class="whitespace-pre-line">
              {display(localized(value!, locale), label)}
            </p>
          </section>
        ))}
      </div>
    )}

    {data.faqs.length > 0 && (
      <section
        class="mt-12 border-t border-line pt-10"
        aria-labelledby="product-faq-title"
      >
        <SectionHeading
          eyebrow={t("products.beforeOrder", locale)}
          title={t("products.questions", locale)}
          id="product-faq-title"
        />
        <FaqAccordion
          class="mt-7"
          items={data.faqs.map(({ q, a }) => ({
            question: display(
              localized(q, locale),
              t("products.todo.question", locale),
            ),
            answer: display(
              localized(a, locale),
              t("products.todo.answer", locale),
            ),
          }))}
        />
      </section>
    )}

    {related.length > 0 && (
      <section
        class="mt-14 border-t border-line pt-10"
        aria-labelledby="related-title"
      >
        <SectionHeading
          eyebrow={t("products.relatedEyebrow", locale)}
          title={t("products.related", locale)}
          id="related-title"
        />
        <div class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {related.map((item) => (
            <ProductCard locale={locale} product={item} />
          ))}
        </div>
      </section>
    )}
  </Container>
</BaseLayout>

<style>
  .product-body :global(h2) {
    margin-top: 2rem;
    font-family: var(--font-display);
    font-size: var(--text-card-title);
    font-weight: 400;
    line-height: 1.15;
  }
  .product-body :global(p),
  .product-body :global(ul),
  .product-body :global(ol) {
    margin-top: 1rem;
    color: var(--color-ink-soft);
    line-height: 1.75;
    overflow-wrap: anywhere;
  }
  .product-body :global(ul),
  .product-body :global(ol) {
    padding-left: 1.25rem;
  }
  .product-body :global(ul) {
    list-style: disc;
  }
  .product-body :global(ol) {
    list-style: decimal;
  }
  .product-body :global(a) {
    color: var(--color-copper);
    text-decoration: underline;
  }
</style>
