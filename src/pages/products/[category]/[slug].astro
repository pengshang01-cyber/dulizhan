---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import AddToInquiryButton from "../../../components/AddToInquiryButton.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import Button from "../../../components/Button.astro";
import Container from "../../../components/Container.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import ProductCard from "../../../components/ProductCard.astro";
import ProductGallery from "../../../components/ProductGallery.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import { display } from "../../../config/site";
import {
  getProducts,
  getProductCategory,
  measurementLabel,
  type Product,
} from "../../../lib/products";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export const getStaticPaths = (async () => {
  const products = await getProducts();
  return products.map((product) => ({
    params: { category: product.data.category, slug: product.data.slug },
    props: {
      product,
      related: products
        .filter(
          (item) =>
            item.data.category === product.data.category &&
            item.data.slug !== product.data.slug,
        )
        .slice(0, 4),
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  product: Product;
  related: Product[];
}
const { product, related } = Astro.props;
const { data } = product;
const { Content } = await render(product);
const category = getProductCategory(data.category);
const title = String(display(data.title, "product name"));
const summary = String(display(data.summary, "product summary"));
const specificationRows = [
  ["Material", display(data.material, "material")],
  [
    "Paper weight",
    typeof data.gsm === "number"
      ? data.gsm + " gsm"
      : display(data.gsm, "paper weight"),
  ],
  ["Minimum order", display(data.moq, "minimum order quantity")],
  ["Packaging", display(data.packaging, "packaging")],
  ["Carton specification", display(data.cartonSpec, "carton specification")],
  ["Lead time", display(data.leadTime, "lead time")],
];
const customization =
  typeof data.customizable === "boolean"
    ? data.customizable
      ? "Customization available"
      : "Customization unavailable"
    : display(data.customizable, "customization options");
---

<BaseLayout
  title={String(display(data.seoTitle ?? data.title, "product title"))}
  description={String(
    display(data.seoDescription ?? data.summary, "product description"),
  )}
>
  <Container class="py-8 sm:py-12">
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: "Products", href: "/products/" },
        { label: category.label, href: "/products/" + category.id + "/" },
        { label: title },
      ]}
    />

    <section
      class="mt-8 grid items-start gap-8 lg:grid-cols-2 lg:gap-12"
      aria-labelledby="product-title"
    >
      <ProductGallery images={data.images} title={title} />
      <div class="min-w-0 lg:py-3">
        <Eyebrow>{category.label}</Eyebrow>
        <h1
          id="product-title"
          class="mt-5 font-display text-page-title font-normal wrap-anywhere"
        >
          {title}
        </h1>
        <p class="mt-4 text-xs font-semibold tracking-[0.12em] wrap-anywhere text-muted uppercase">
          SKU / {display(data.sku, "SKU")}
        </p>
        <p class="mt-6 text-base leading-relaxed text-ink-soft">{summary}</p>
        <p class="mt-7 text-xs font-extrabold tracking-[0.14em] text-copper uppercase">
          Ask for pricing
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <Button
            href={
              "/contact/?product=" + encodeURIComponent(data.slug) + "#quote"
            }
          >
            Get a Quote
          </Button>
          <AddToInquiryButton
            product={{
              slug: data.slug,
              sku: data.sku,
              title: data.title,
              category: data.category,
            }}
            class="min-h-12 px-5"
          />
        </div>
        <p class="mt-5 text-sm leading-relaxed text-ink-soft">
          Add this product to your inquiry list to request a quote for several
          styles together.
        </p>
      </div>
    </section>

    <section
      class="mt-14 border-t border-line pt-10 sm:mt-20"
      aria-labelledby="specifications-title"
    >
      <SectionHeading
        eyebrow="Product details"
        title="Specifications"
        id="specifications-title"
      />
      <dl class="mt-7 grid gap-px overflow-hidden rounded-panel border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        {specificationRows.map(([label, value]) => (
          <div class="min-w-0 bg-white p-5">
            <dt class="text-[0.6875rem] font-bold tracking-[0.1em] text-ink-soft uppercase">
              {label}
            </dt>
            <dd class="mt-2 text-sm leading-relaxed wrap-anywhere">{value}</dd>
          </div>
        ))}
      </dl>
      <h3 class="mt-8 font-display text-card-title font-normal">Sizes</h3>
      <div
        data-size-table
        role="region"
        aria-label="Product sizes"
        tabindex="0"
        class="mt-4 max-w-full overflow-x-auto rounded-panel border border-line bg-white"
      >
        <table class="w-full min-w-[42rem] border-collapse text-left text-sm">
          <caption class="sr-only">Product dimensions in millimeters</caption>
          <thead class="border-b border-line bg-paper text-xs text-ink-soft">
            <tr>
              <th scope="col" class="px-5 py-4 font-bold">
                Size
              </th>
              <th scope="col" class="px-5 py-4 font-bold">
                Base diameter
              </th>
              <th scope="col" class="px-5 py-4 font-bold">
                Height
              </th>
              <th scope="col" class="px-5 py-4 font-bold">
                Top diameter
              </th>
            </tr>
          </thead>
          <tbody>
            {data.sizes.map((size) => (
              <tr class="border-b border-line last:border-b-0">
                <th scope="row" class="px-5 py-4 font-semibold">
                  {display(size.name, "size name")}
                </th>
                <td class="px-5 py-4">
                  {measurementLabel(size.baseDiameterMm, "base diameter")}
                </td>
                <td class="px-5 py-4">
                  {measurementLabel(size.heightMm, "height")}
                </td>
                <td class="px-5 py-4">
                  {measurementLabel(size.topDiameterMm, "top diameter")}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section
      class="mt-10 grid gap-5 sm:grid-cols-3"
      aria-label="Available options"
    >
      <div class="min-w-0 rounded-panel border border-line bg-white p-5">
        <h2 class="font-display text-card-title font-normal">Colors</h2>
        <ul class="mt-3 grid gap-2 text-sm leading-relaxed text-ink-soft">
          {data.colors.map((color) => (
            <li>{display(color, "available colors")}</li>
          ))}
        </ul>
      </div>
      <div class="min-w-0 rounded-panel border border-line bg-white p-5">
        <h2 class="font-display text-card-title font-normal">Patterns</h2>
        <ul class="mt-3 grid gap-2 text-sm leading-relaxed text-ink-soft">
          {data.patterns.map((pattern) => (
            <li>{display(pattern, "available patterns")}</li>
          ))}
        </ul>
      </div>
      <div class="min-w-0 rounded-panel border border-line bg-white p-5">
        <h2 class="font-display text-card-title font-normal">Customization</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft">
          {customization}
        </p>
      </div>
    </section>

    <div class="product-body mt-10 max-w-3xl border-t border-line pt-2">
      <Content />
    </div>

    {data.faqs.length > 0 && (
      <section
        class="mt-12 border-t border-line pt-10"
        aria-labelledby="product-faq-title"
      >
        <SectionHeading
          eyebrow="Before you order"
          title="Product Questions"
          id="product-faq-title"
        />
        <div class="mt-7 grid gap-3">
          {data.faqs.map(({ q, a }) => (
            <details class="rounded-control border border-line bg-white">
              <summary class="cursor-pointer px-5 py-4 text-sm leading-relaxed font-semibold">
                {display(q, "product question")}
              </summary>
              <p class="px-5 pb-5 text-sm leading-relaxed text-ink-soft">
                {display(a, "product answer")}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section
        class="mt-14 border-t border-line pt-10"
        aria-labelledby="related-title"
      >
        <SectionHeading
          eyebrow="Explore the collection"
          title="Related Products"
          id="related-title"
        />
        <div class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {related.map((item) => (
            <ProductCard product={item} />
          ))}
        </div>
      </section>
    )}
  </Container>
</BaseLayout>

<style>
  .product-body :global(h2) {
    margin-top: 2rem;
    font-family: var(--font-display);
    font-size: var(--text-card-title);
    font-weight: 400;
    line-height: 1.15;
  }
  .product-body :global(p),
  .product-body :global(ul),
  .product-body :global(ol) {
    margin-top: 1rem;
    color: var(--color-ink-soft);
    line-height: 1.75;
    overflow-wrap: anywhere;
  }
  .product-body :global(ul),
  .product-body :global(ol) {
    padding-left: 1.25rem;
  }
  .product-body :global(ul) {
    list-style: disc;
  }
  .product-body :global(ol) {
    list-style: decimal;
  }
  .product-body :global(a) {
    color: var(--color-copper);
    text-decoration: underline;
  }
</style>
