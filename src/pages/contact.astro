---
import PagePlaceholder from "../components/PagePlaceholder.astro";
import { display } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact">
  <PagePlaceholder title="Contact" headingId="quote">
    <p
      id="privacy-policy"
      class="mt-7 w-fit scroll-mt-5 rounded-control border border-line bg-surface px-4 py-3 text-sm text-muted target:border-primary target:bg-primary-soft"
    >
      {display("TODO_PRIVACY_POLICY", "privacy policy")}
    </p>
  </PagePlaceholder>
</BaseLayout>
