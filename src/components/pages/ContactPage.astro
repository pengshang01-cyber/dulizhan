---
import { localePath } from "../../i18n/routing";
import { t, confirmedLocalized, type Locale } from "../../i18n/utils";
interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;
import { Image } from "astro:assets";
import { resolveSiteImage } from "../../lib/site-images";
import Container from "../Container.astro";
import DisplayHeading from "../DisplayHeading.astro";
import Eyebrow from "../Eyebrow.astro";
import InquiryForm from "../InquiryForm.astro";
import SectionHeading from "../SectionHeading.astro";
import SocialLinks from "../SocialLinks.astro";
import { getWhatsAppHref, site } from "../../config/site";
import { confirmedText } from "../../lib/placeholders";
import BaseLayout from "../../layouts/BaseLayout.astro";

const email = confirmedText(site.email);
const phone = confirmedText(site.phone);
const address = confirmedLocalized(site.factoryAddress, locale);
const wechatId = confirmedText(site.wechatId);
const wechatQr = wechatId ? resolveSiteImage(site.wechatQr) : undefined;
const contactCards = {
  email: {
    key: "email",
    label: t("site.email", locale),
    value: email,
    href: email ? "mailto:" + email : undefined,
  },
  phone: {
    key: "phone",
    label: t("site.phone", locale),
    value: phone,
    href: phone ? "tel:" + phone.replace(/[^+\d]/g, "") : undefined,
  },
  whatsapp: {
    key: "whatsapp",
    label: t("site.whatsapp", locale),
    value: confirmedText(site.whatsappNumber),
    href: getWhatsAppHref(
      site.whatsappNumber,
      confirmedLocalized(site.whatsappPrefillMessage, locale),
    ),
  },
  address: {
    key: "address",
    label: t("contact.address", locale),
    value: address,
    href: undefined,
  },
  wechat: {
    key: "wechat",
    label: t("contact.wechat", locale),
    value: wechatId,
    href: undefined,
  },
};
const order =
  locale === "zh"
    ? (["wechat", "phone", "whatsapp", "email", "address"] as const)
    : (["email", "phone", "whatsapp", "address", "wechat"] as const);
const contacts = order
  .map((key) => contactCards[key])
  .filter(({ value }) => value);
const mapUrl = address
  ? `https://maps.google.com/maps?q=${encodeURIComponent(address)}&output=embed`
  : undefined;
---

<BaseLayout locale={locale}>
  <Container class="py-12 sm:py-20">
    <Eyebrow class="mb-5">{t("contact.eyebrow", locale)}</Eyebrow>
    <DisplayHeading
      first={t("contact.first", locale)}
      second={t("contact.second", locale)}
    />
    <p class="mt-6 max-w-2xl leading-relaxed text-ink-soft">
      {t("contact.intro", locale)}
    </p>
    {contacts.length > 0 && (
      <div class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {contacts.map(({ key, label, value, href }) => (
          <section
            data-contact-method={key}
            data-wechat-card={key === "wechat" || undefined}
            class="min-w-0 rounded-panel border border-line bg-white p-6"
          >
            <h2 class="text-xs font-bold tracking-[0.12em] text-ink-soft uppercase">
              {label}
            </h2>
            <p class="mt-4 text-sm leading-relaxed wrap-anywhere">
              {href ? (
                <a
                  href={href}
                  data-track={
                    key === "email"
                      ? "email_click"
                      : key === "phone"
                        ? "phone_click"
                        : key === "whatsapp"
                          ? "whatsapp_click"
                          : undefined
                  }
                  class="text-copper hover:text-copper-dark"
                >
                  {value}
                </a>
              ) : (
                value
              )}
            </p>
            {key === "wechat" && wechatQr && (
              <Image
                src={wechatQr}
                alt={t("contact.wechatQr", locale)}
                width={320}
                format="png"
                loading="lazy"
                class="mt-4 h-auto w-48 max-w-full"
              />
            )}
          </section>
        ))}
      </div>
    )}
    <SocialLinks
      locale={locale}
      class="mt-6"
      linkClass="border-line bg-white text-ink-soft"
    />
  </Container>

  <section
    class="border-y border-line bg-paper py-14 sm:py-20"
    aria-labelledby="quote-title"
  >
    <Container class="max-w-5xl">
      <div
        id="quote"
        class="rounded-panel border border-line bg-white p-6 sm:p-10"
      >
        <SectionHeading
          eyebrow={t("contact.quoteEyebrow", locale)}
          title={t("contact.quoteTitle", locale)}
          id="quote-title"
          description={t("contact.quoteDescription", locale)}
        />
        <InquiryForm locale={locale} />
      </div>
    </Container>
  </section>

  {mapUrl && (
    <section aria-labelledby="factory-location-title" class="py-14 sm:py-20">
      <Container>
        <SectionHeading
          eyebrow={t("contact.mapEyebrow", locale)}
          title={t("contact.mapTitle", locale)}
          id="factory-location-title"
        />
        <iframe
          src={mapUrl}
          title={t("contact.mapAlt", locale)}
          width="1200"
          height="480"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="mt-8 h-80 w-full rounded-panel border border-line sm:h-[30rem]"
          allowfullscreen
        ></iframe>
      </Container>
    </section>
  )}

  <Container class="py-8">
    <p
      id="privacy-policy"
      class="w-fit rounded-control border border-line bg-white px-4 py-3 text-sm text-ink-soft target:border-copper target:bg-paper"
    >
      <a
        href={localePath("/privacy-policy/", locale)}
        class="text-copper underline"
      >
        {t("site.privacyPolicy", locale)}
      </a>
    </p>
  </Container>
</BaseLayout>
