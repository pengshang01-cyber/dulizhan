---
import { t, localized, type Locale } from "../i18n/utils";
interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;
import { localePath } from "../i18n/routing";
import { getVisibleCategories } from "../lib/products";
const productCategories = await getVisibleCategories();
import {
  display,
  getWhatsAppHref,
  isTodo,
  navigation,
  site,
  type SocialPlatform,
} from "../config/site";
import BrandIcon from "./BrandIcon.astro";
import Container from "./Container.astro";

const company = display(
  localized(site.companyName, locale),
  t("site.companyNameLabel", locale),
);
const labels = {
  youtube: t("site.social.youtube", locale),
  tiktok: t("site.social.tiktok", locale),
  instagram: t("site.social.instagram", locale),
  facebook: t("site.social.facebook", locale),
  pinterest: t("site.social.pinterest", locale),
  linkedin: t("site.social.linkedin", locale),
} satisfies Record<SocialPlatform, string>;
const socials = Object.entries(labels).map(([platform, label]) => {
  const name = platform as SocialPlatform;
  const url = site.socialLinks[name];
  return {
    name,
    label,
    href: url && !isTodo(url) ? url : undefined,
    placeholder: display(url, t("site.socialUrl", locale, { platform: label })),
  };
});
const phone = site.phone.replace(/[^\d+]/g, "");
const emailContact = {
  label: t("site.email", locale),
  value: display(site.email, t("site.emailLabel", locale)),
  href: site.email && !isTodo(site.email) ? "mailto:" + site.email : undefined,
};
const phoneContact = {
  label: t("site.phone", locale),
  value: display(site.phone, t("site.phoneLabel", locale)),
  href: phone && !isTodo(site.phone) ? "tel:" + phone : undefined,
};
const whatsappContact = {
  label: t("site.whatsapp", locale),
  value: display(site.whatsappNumber, t("site.whatsappNumberLabel", locale)),
  href: getWhatsAppHref(
    site.whatsappNumber,
    localized(site.whatsappPrefillMessage, locale),
  ),
};
const wechatContact =
  site.wechatId.trim() && !isTodo(site.wechatId.trim())
    ? [
        {
          label: t("contact.wechat", locale),
          value: site.wechatId,
          href: undefined,
        },
      ]
    : [];
const contacts =
  locale === "zh"
    ? [...wechatContact, phoneContact, emailContact]
    : [emailContact, phoneContact, whatsappContact, ...wechatContact];
const linkClass = "rounded-control hover:text-copper";
const socialClass =
  "grid size-9 place-items-center rounded-control border border-sand/20";
---

<footer class="bg-coffee text-sand">
  <Container class="grid grid-cols-2 gap-x-5 gap-y-8 pt-11 pb-10 lg:grid-cols-[1.25fr_0.7fr_1fr_1fr] lg:gap-x-8 lg:pt-14 lg:pb-12">
    <div class="col-span-2 min-w-0 lg:col-span-1">
      <a
        href={localePath("/", locale)}
        class="rounded-control font-display text-card-title wrap-anywhere text-cream hover:text-copper"
      >
        {company}
      </a>
      <p class="mt-2.5 text-sm wrap-anywhere">
        {display(
          localized(site.factoryAddress, locale),
          t("site.addressLabel", locale),
        )}
      </p>
      <ul
        aria-label={t("site.socialMedia", locale)}
        class="mt-5 flex flex-wrap gap-2"
      >
        {socials.map(({ name, label, href, placeholder }) => (
          <li>
            {href ? (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={label}
                class:list={[
                  socialClass,
                  "hover:border-copper hover:text-copper",
                ]}
              >
                <BrandIcon name={name} class="size-3.5" />
              </a>
            ) : (
              <span
                role="img"
                aria-label={placeholder}
                title={placeholder}
                class:list={[socialClass, "text-sand/70"]}
              >
                <BrandIcon name={name} class="size-3.5" />
              </span>
            )}
          </li>
        ))}
      </ul>
    </div>

    <nav aria-label={t("nav.quickLinks", locale)}>
      <h2 class="font-display text-xl font-normal text-cream">
        {t("nav.quickLinks", locale)}
      </h2>
      <ul class="mt-3.5 grid gap-2.5 text-sm">
        {navigation.map(({ key, href }) => (
          <li>
            <a href={localePath(href, locale)} class={linkClass}>
              {t(key, locale)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-label={t("nav.categories", locale)}>
      <h2 class="font-display text-xl font-normal text-cream">
        {t("nav.categories", locale)}
      </h2>
      <ul class="mt-3.5 grid gap-2.5 text-sm">
        {productCategories.map(({ id, label }) => (
          <li>
            <a
              href={localePath("/products/" + id + "/", locale)}
              class={linkClass}
            >
              {localized(label, locale)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="col-span-2 min-w-0 lg:col-span-1">
      <h2 class="font-display text-xl font-normal text-cream">
        {t("nav.contact", locale)}
      </h2>
      <address class="mt-3.5 not-italic">
        <dl class="grid gap-3 text-sm">
          {contacts.map(({ label, value, href }) => (
            <div>
              <dt class="text-xs font-semibold text-cream">{label}</dt>
              <dd class="mt-0.5 wrap-anywhere">
                {href ? (
                  <a
                    href={href}
                    data-track={
                      href.startsWith("mailto:")
                        ? "email_click"
                        : href.startsWith("tel:")
                          ? "phone_click"
                          : href.startsWith("https://wa.me/")
                            ? "whatsapp_click"
                            : undefined
                    }
                    class={linkClass}
                  >
                    {value}
                  </a>
                ) : (
                  value
                )}
              </dd>
            </div>
          ))}
        </dl>
      </address>
    </div>
  </Container>

  <div class="border-t border-sand/20">
    <Container class="flex flex-wrap justify-between gap-x-6 gap-y-3 py-5 text-xs">
      <p class="wrap-anywhere">
        © {new Date().getUTCFullYear()} {company}
      </p>
      <a href={localePath("/privacy-policy/", locale)} class={linkClass}>
        {t("site.privacyPolicy", locale)}
      </a>
      <button type="button" data-cookie-settings class={linkClass}>
        {t("cookie.settings", locale)}
      </button>
    </Container>
  </div>
</footer>
