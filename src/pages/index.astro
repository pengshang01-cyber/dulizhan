---
import PagePlaceholder from "../components/PagePlaceholder.astro";
import { display, site } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const companyName = display(site.companyName, "company name");
---

<BaseLayout title={companyName}>
  <PagePlaceholder
    title={companyName}
    description="Cupcake Liners and Baking Cups"
  />
</BaseLayout>
