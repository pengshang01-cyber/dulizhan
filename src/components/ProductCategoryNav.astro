---
import { productCategories } from "../config/categories";
interface Props {
  current?: string;
}
const { current } = Astro.props;
const links = [
  { label: "All products", href: "/products/", id: undefined },
  ...productCategories.map(({ id, label }) => ({
    id,
    label,
    href: "/products/" + id + "/",
  })),
];
---

<nav aria-label="Product categories">
  <ul class="flex flex-wrap gap-2">
    {links.map(({ id, label, href }) => (
      <li>
        <a
          href={href}
          aria-current={current === id ? "page" : undefined}
          class="inline-flex min-h-11 items-center rounded-control border border-line bg-white px-3 py-2 text-xs font-semibold text-ink-soft transition-colors hover:border-copper hover:text-copper aria-[current=page]:border-coffee aria-[current=page]:bg-coffee aria-[current=page]:text-white"
        >
          {label}
        </a>
      </li>
    ))}
  </ul>
</nav>
