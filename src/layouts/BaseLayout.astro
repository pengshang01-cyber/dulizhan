---
const locale = "en";
import { t } from "../i18n/utils";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import TopBar from "../components/TopBar.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string | URL;
  og?: {
    title?: string;
    description?: string;
    image?: string;
    url?: string;
  };
  noindex?: boolean;
}

const { title, description, canonical, og, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical.toString()} />}
    {og?.title && <meta property="og:title" content={og.title} />}
    {og?.description && (
      <meta property="og:description" content={og.description} />
    )}
    {og?.image && <meta property="og:image" content={og.image} />}
    {og?.url && <meta property="og:url" content={og.url} />}
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body class="flex min-h-screen flex-col bg-cream font-sans text-ink antialiased">
    <a
      href="#main-content"
      class="sr-only font-semibold focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-40 focus:rounded-control focus:bg-white focus:px-4 focus:py-3"
    >
      {t("pages.baselayout.skip_to_content", locale)}
    </a>
    <TopBar />
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
  </body>
</html>
