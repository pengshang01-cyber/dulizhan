---
import PagePlaceholder from "../components/PagePlaceholder.astro";
import { productCategories } from "../config/categories";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Products">
  <PagePlaceholder title="Products">
    <ul
      aria-label="Product categories"
      class="mt-8 grid max-w-3xl gap-2.5 sm:grid-cols-2 lg:grid-cols-3"
    >
      {productCategories.map(({ id, label }) => (
        <li
          id={id}
          class="rounded-control border border-line bg-white px-4 py-3 text-sm font-semibold target:border-copper target:bg-paper"
        >
          {label}
        </li>
      ))}
    </ul>
  </PagePlaceholder>
</BaseLayout>
