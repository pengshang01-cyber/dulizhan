---
import { site } from "../../config/site";
import { confirmedLocalized, t, type Locale } from "../../i18n/utils";
import { localePath } from "../../i18n/routing";
import { getProducts } from "../../lib/products";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../Container.astro";
import Eyebrow from "../Eyebrow.astro";
import DisplayHeading from "../DisplayHeading.astro";
import SectionHeading from "../SectionHeading.astro";
import InquiryContactOptions from "../InquiryContactOptions.astro";
import ProductCard from "../ProductCard.astro";
import Button from "../Button.astro";

interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;
const recommended = (await getProducts()).slice(0, 3);
const replyTime = confirmedLocalized(site.replyTime, locale);
---

<BaseLayout locale={locale} noindex>
  <Container class="py-14 sm:py-20">
    <Eyebrow class="mb-5">{t("thankYou.eyebrow", locale)}</Eyebrow>
    <DisplayHeading
      first={t("thankYou.first", locale)}
      second={t("thankYou.second", locale)}
    />
    <p class="mt-6 max-w-2xl leading-relaxed text-ink-soft">
      {t("thankYou.description", locale)}
    </p>
    <div class="mt-8 max-w-2xl rounded-panel border border-line bg-white p-6 sm:p-8">
      {replyTime && (
        <div>
          <h2 class="text-xs font-bold tracking-[0.12em] text-muted uppercase">
            {t("thankYou.replyTime", locale)}
          </h2>
          <p class="mt-3 text-lg leading-relaxed">{replyTime}</p>
        </div>
      )}
      <h2 class:list={["font-display text-card-title", replyTime && "mt-6"]}>
        {t("thankYou.contact", locale)}
      </h2>
      <InquiryContactOptions locale={locale} />
      <Button
        href={localePath("/contact/", locale)}
        variant="secondary"
        class="mt-5"
      >
        {t("nav.contact", locale)}
      </Button>
    </div>
  </Container>
  {recommended.length > 0 && (
    <section
      class="border-y border-line bg-paper py-14 sm:py-20"
      aria-labelledby="thank-you-products-title"
    >
      <Container>
        <SectionHeading
          id="thank-you-products-title"
          eyebrow={t("thankYou.recommendedEyebrow", locale)}
          title={t("thankYou.recommended", locale)}
        />
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {recommended.map((product) => (
            <ProductCard locale={locale} product={product} />
          ))}
        </div>
      </Container>
    </section>
  )}
</BaseLayout>
