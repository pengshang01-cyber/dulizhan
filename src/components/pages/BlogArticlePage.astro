---
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { site } from "../../config/site";
import { localized, t, type Locale } from "../../i18n/utils";
import { configuredOrigin } from "../../lib/seo";
import { articleData } from "../../lib/blog-seo";
import { getBlogPosts, type BlogPost } from "../../lib/blog";
import { blogHref, blogPageHref } from "../../lib/blog-rules";
import { renderBlogMarkdown } from "../../lib/blog-markdown";
import { getProducts } from "../../lib/products";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../Container.astro";
import Breadcrumbs from "../Breadcrumbs.astro";
import Eyebrow from "../Eyebrow.astro";
import ProductCard from "../ProductCard.astro";
import QuoteButton from "../QuoteButton.astro";
interface Props {
  locale: Locale;
  post: BlogPost;
}
const { locale, post } = Astro.props;
const { data } = post;
const title = localized(data.title, locale);
const posts = await getBlogPosts(locale);
const index = posts.findIndex((item) => item.id === post.id);
const previous = posts[index + 1];
const next = posts[index - 1];
const languagePaths = {
  en: blogHref(post.id, "en"),
  ...(data.bodyZh?.trim() && { zh: blogHref(post.id, "zh") }),
};
const images = import.meta.glob<ImageMetadata>(
  "/src/assets/images/blog/**/*.{png,jpg,jpeg,webp,avif}",
  { eager: true, import: "default" },
);
const rendered = await renderBlogMarkdown(
  locale === "zh" ? data.bodyZh : data.bodyEn,
  locale,
  async (path) => {
    const key = path.replace(/^\.\.\/\.\.\/assets\//, "/src/assets/");
    const source = images[key];
    if (!source) throw new Error("缺少文章图片：" + path);
    const optimized = await getImage({
      src: source,
      width: Math.min(1200, source.width),
      format: "webp",
    });
    return {
      src: optimized.src,
      width: Number(optimized.attributes.width),
      height: Number(optimized.attributes.height),
    };
  },
);
const related = (await getProducts()).filter((product) =>
  data.relatedProducts.includes(product.data.slug),
);
const formatted = (date: string) =>
  new Intl.DateTimeFormat(locale === "zh" ? "zh-CN" : "en-US", {
    dateStyle: "long",
    timeZone: "UTC",
  }).format(new Date(date + "T00:00:00Z"));
const origin = configuredOrigin(site.domain) ?? Astro.url.origin;
const cover = await getImage({ src: data.cover, width: 1200, format: "webp" });
const url = new URL(blogHref(post.id, locale), origin).href;
---

<BaseLayout
  locale={locale}
  title={title}
  description={localized(data.description, locale)}
  languagePaths={languagePaths}
  ogType="article"
  og={data.cover.src.includes("placeholder") ? undefined : { image: cover.src }}
  structuredData={articleData(
    post,
    locale,
    url,
    new URL(cover.src, origin).href,
  )}
>
  <Container class="py-8 sm:py-12">
    <Breadcrumbs
      locale={locale}
      items={[
        { label: t("nav.blog", locale), href: blogPageHref(1, locale) },
        { label: title },
      ]}
    />
    <header class="mx-auto mt-9 max-w-4xl">
      <Eyebrow class="mb-5">{t("blog.eyebrow", locale)}</Eyebrow>
      <h1 class="font-display text-page-title font-normal text-balance">
        {title}
      </h1>
      <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-xs text-ink-soft">
        <span>
          {t("blog.published", locale)}{" "}
          <time datetime={data.date}>{formatted(data.date)}</time>
        </span>
        {data.updated && (
          <span>
            {t("blog.updated", locale)}{" "}
            <time datetime={data.updated}>{formatted(data.updated)}</time>
          </span>
        )}
      </div>
      {data.tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2">
          {data.tags.map((tag) => (
            <li class="rounded-control border border-line bg-white px-3 py-1 text-xs text-ink-soft">
              {localized(tag, locale)}
            </li>
          ))}
        </ul>
      )}
      <p class="mt-6 leading-relaxed text-ink-soft">
        {localized(data.description, locale)}
      </p>
    </header>
    <Image
      src={data.cover}
      alt={t(
        data.cover.src.includes("placeholder")
          ? "blog.placeholder"
          : "blog.cover",
        locale,
        { title },
      )}
      widths={[480, 800, 1200, 1600]}
      sizes="(min-width: 1280px) 1200px, calc(100vw - 2.5rem)"
      format="webp"
      loading="eager"
      fetchpriority="high"
      class="mt-10 aspect-video w-full rounded-panel border border-line object-cover"
    />
    <div class="mt-12 grid items-start gap-10 lg:grid-cols-[15rem_minmax(0,1fr)]">
      <aside class="rounded-panel border border-line bg-white p-6 lg:sticky lg:top-28">
        <h2
          class="font-display text-card-title font-normal"
          id="blog-toc-title"
        >
          {t("blog.contents", locale)}
        </h2>
        {rendered.headings.length > 0 && (
          <nav aria-labelledby="blog-toc-title" class="mt-5">
            <ul class="grid gap-3 text-sm leading-relaxed">
              {rendered.headings.map((heading) => (
                <li class:list={[heading.depth === 3 && "pl-4"]}>
                  <a
                    href={"#" + encodeURIComponent(heading.slug)}
                    class="text-ink-soft hover:text-copper"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </aside>
      <article
        class="blog-prose min-w-0 max-w-none"
        data-blog-body
        set:html={rendered.html}
      />
    </div>
    {(previous || next) && (
      <nav
        class="mt-12 grid gap-5 border-t border-line pt-8 sm:grid-cols-2"
        aria-label={t("blog.all", locale)}
      >
        {previous ? (
          <a
            href={blogHref(previous.id, locale)}
            rel="prev"
            class="rounded-panel border border-line bg-white p-6 hover:border-copper"
          >
            <span class="block text-xs font-bold text-copper">
              ← {t("blog.previous", locale)}
            </span>
            <span class="mt-3 block font-display text-card-title">
              {localized(previous.data.title, locale)}
            </span>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a
            href={blogHref(next.id, locale)}
            rel="next"
            class="rounded-panel border border-line bg-white p-6 hover:border-copper"
          >
            <span class="block text-xs font-bold text-copper">
              {t("blog.next", locale)} →
            </span>
            <span class="mt-3 block font-display text-card-title">
              {localized(next.data.title, locale)}
            </span>
          </a>
        )}
      </nav>
    )}
  </Container>
  {related.length > 0 && (
    <section class="border-t border-line bg-paper py-12">
      <Container>
        <h2 class="font-display text-section-title font-normal">
          {t("blog.related", locale)}
        </h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((product) => (
            <ProductCard product={product} locale={locale} />
          ))}
        </div>
      </Container>
    </section>
  )}
  <section class="dark-surface py-12 sm:py-16">
    <Container>
      <Eyebrow class="mb-5">{t("blog.ctaEyebrow", locale)}</Eyebrow>
      <h2 class="font-display text-section-title font-normal">
        {t("blog.ctaTitle", locale)}
      </h2>
      <p class="mt-5 max-w-2xl leading-relaxed text-sand">
        {t("blog.ctaText", locale)}
      </p>
      <QuoteButton locale={locale} class="mt-7" />
    </Container>
  </section>
</BaseLayout>
