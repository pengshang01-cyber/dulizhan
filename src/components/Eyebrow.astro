---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<p
  class:list={[
    "eyebrow flex items-center gap-3 text-[0.625rem] leading-relaxed font-bold tracking-[0.2em] text-copper-dark uppercase sm:text-[0.6875rem]",
    className,
  ]}
>
  <span aria-hidden="true" class="h-px w-6 shrink-0 bg-copper"></span>
  <span>
    <slot />
  </span>
</p>
