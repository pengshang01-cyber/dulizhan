---
import type { Locale } from "../i18n/utils";
const { locale = "en" } = Astro.props;
import { t } from "../i18n/utils";
import Container from "./Container.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  locale?: Locale;
  title: string;
  description?: string;
  headingId?: string;
}

const { title, description, headingId } = Astro.props;
---

<section class="py-14 sm:py-20 lg:py-24">
  <Container>
    <SectionHeading
      eyebrow={t("pages.pageplaceholder.factory_direct", locale)}
      title={title}
      description={description}
      id={headingId}
      level={1}
    />
    <slot />
  </Container>
</section>
