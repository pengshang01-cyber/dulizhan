---
import type { HTMLAttributes } from "astro/types";

type ButtonStyle = {
  variant?: "primary" | "secondary" | "ghost";
};
type Props = ButtonStyle &
  (
    | (HTMLAttributes<"a"> & { href: string })
    | (HTMLAttributes<"button"> & { href?: undefined })
  );

const {
  variant = "primary",
  class: className,
  type,
  ...attributes
} = Astro.props;
const buttonType = type === "submit" || type === "reset" ? type : "button";
const variants = {
  primary:
    "button-primary border-coffee bg-coffee text-white hover:bg-coffee-2 hover:border-coffee-2",
  secondary:
    "button-secondary border-ink bg-transparent text-ink hover:bg-paper hover:text-coffee",
  ghost: "border-transparent bg-transparent text-copper hover:text-copper-dark",
};
const classes = [
  "inline-flex min-h-11 max-w-full items-center justify-center gap-3 rounded-control border px-3.5 py-3 text-center text-[0.6875rem] leading-tight font-extrabold tracking-[0.06em] uppercase transition-colors disabled:cursor-not-allowed disabled:opacity-55 motion-reduce:transition-none sm:px-5 sm:text-xs",
  variants[variant],
  className,
];
---

{attributes.href !== undefined ? (
  <a {...attributes} type={type} class:list={classes}>
    <slot />
    {variant === "primary" && <span aria-hidden="true">→</span>}
  </a>
) : (
  <button type={buttonType} {...attributes} class:list={classes}>
    <slot />
    {variant === "primary" && <span aria-hidden="true">→</span>}
  </button>
)}
