---
interface Props {
  items: readonly { question: string; answer: string }[];
  firstOpen?: boolean;
  class?: string;
}

const { items, firstOpen = false, class: className } = Astro.props;
---

<div class:list={["grid gap-3", className]} data-faq-accordion>
  {items.map(({ question, answer }, index) => (
    <details
      open={firstOpen && index === 0}
      class="group rounded-control border border-line bg-white text-ink"
    >
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-control px-4 py-4 text-sm leading-relaxed font-bold sm:px-5">
        <span>{question}</span>
        <span
          aria-hidden="true"
          class="shrink-0 text-xl leading-none text-copper group-open:hidden"
        >
          +
        </span>
        <span
          aria-hidden="true"
          class="hidden shrink-0 text-xl leading-none text-copper group-open:inline"
        >
          −
        </span>
      </summary>
      <p class="px-4 pb-5 text-sm leading-relaxed whitespace-pre-line text-ink-soft sm:px-5">
        {answer}
      </p>
    </details>
  ))}
</div>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
  summary::marker {
    content: "";
  }
</style>
