---
import type { Locale } from "../i18n/utils";
import { Image } from "astro:assets";
import { confirmedLocalized, t } from "../i18n/utils";
import type { ProductData } from "../lib/products";
const { locale = "en" } = Astro.props;

interface Props {
  locale?: Locale;
  images: ProductData["images"];
  title: string;
}
const { images, title } = Astro.props;

function galleryLabel(view: ProductData["images"][number]) {
  if (view.technicalDrawing) {
    return [
      t("technical.drawing", locale),
      confirmedLocalized(view.alt, locale),
    ]
      .filter(Boolean)
      .join(" · ");
  }
  if (view.scene) {
    return [
      t("products.illustrativeImage", locale),
      t(`products.sceneLabel.${view.scene}`, locale),
    ].join(" · ");
  }
  if (view.sizeComparison) {
    return [
      t("products.sizeComparison", locale),
      confirmedLocalized(view.alt, locale),
    ]
      .filter(Boolean)
      .join(" · ");
  }
}
---

<div data-product-gallery class="min-w-0">
  <div class="overflow-hidden rounded-panel border border-line bg-paper">
    {images.map((view, index) => (
      <figure
        data-gallery-panel
        data-scene={view.scene}
        data-size-comparison={view.sizeComparison || undefined}
        data-technical-drawing={view.technicalDrawing || undefined}
        hidden={index !== 0}
      >
        <Image
          src={view.image}
          alt={
            confirmedLocalized(view.alt, locale) ??
            t(
              view.image.src.includes("placeholder")
                ? "products.galleryPlaceholder"
                : "products.galleryView",
              locale,
              { title, index: index + 1 },
            )
          }
          widths={[384, 720, 1200]}
          sizes="(min-width: 80rem) 36rem, (min-width: 1024px) 47vw, calc(100vw - 2.5rem)"
          format="webp"
          loading={index === 0 ? "eager" : "lazy"}
          fetchpriority={index === 0 ? "high" : "auto"}
          class:list={[
            "w-full object-contain",
            view.sizeComparison || view.technicalDrawing
              ? "aspect-[4/3]"
              : "aspect-square",
          ]}
        />
        {galleryLabel(view) && (
          <figcaption class="border-t border-line bg-white px-4 py-3 text-sm text-ink-soft">
            {galleryLabel(view)}
          </figcaption>
        )}
      </figure>
    ))}
  </div>
  {images.length > 1 && (
    <div
      class="mt-3 flex flex-wrap gap-3"
      aria-label={t("products.galleryViews", locale)}
    >
      {images.map((view, index) => (
        <button
          type="button"
          data-gallery-index={index}
          aria-label={
            galleryLabel(view) ??
            t("products.showImage", locale, { index: index + 1 })
          }
          aria-pressed={index === 0}
          class="size-20 overflow-hidden rounded-control border border-line bg-white p-1 transition-colors hover:border-copper aria-pressed:border-copper"
        >
          <Image
            src={view.image}
            alt=""
            width={80}
            height={80}
            format="webp"
            loading="lazy"
            class="size-full object-cover"
          />
        </button>
      ))}
    </div>
  )}
</div>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-product-gallery]")
    .forEach((gallery) => {
      const panels = gallery.querySelectorAll<HTMLElement>(
        "[data-gallery-panel]",
      );
      const buttons = gallery.querySelectorAll<HTMLButtonElement>(
        "[data-gallery-index]",
      );
      buttons.forEach((button, selected) => {
        button.addEventListener("click", () => {
          panels.forEach((panel, index) => {
            panel.hidden = index !== selected;
          });
          buttons.forEach((item, index) => {
            item.setAttribute("aria-pressed", String(index === selected));
          });
        });
      });
    });
</script>
