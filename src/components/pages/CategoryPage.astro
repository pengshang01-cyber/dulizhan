---
import type { Locale } from "../../i18n/utils";
import Breadcrumbs from "../Breadcrumbs.astro";
import Container from "../Container.astro";
import ProductCard from "../ProductCard.astro";
import ProductCategoryNav from "../ProductCategoryNav.astro";
import SectionHeading from "../SectionHeading.astro";
import { localized, t } from "../../i18n/utils";
import { type Product, type ProductCategory } from "../../lib/products";
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Props {
  locale?: Locale;
  category: ProductCategory;
  products: Product[];
}
const { category, products } = Astro.props;
const { locale = "en" } = Astro.props;
const label = localized(category.label, locale);
const summary = localized(category.summary, locale);
---

<BaseLayout
  locale={locale}
  title={t("seo.category.title", locale, { label })}
  description={t("seo.category.description", locale, { label })}
>
  <Container class="py-8 sm:py-12">
    <Breadcrumbs
      locale={locale}
      items={[
        { label: t("breadcrumbs.home", locale), href: "/" },
        { label: t("breadcrumbs.products", locale), href: "/products/" },
        { label },
      ]}
    />
    <div class="mt-8 max-w-3xl">
      <SectionHeading
        eyebrow={t("products.collectionEyebrow", locale)}
        title={label}
        level={1}
        description={summary}
      />
    </div>
    <div class="mt-8 border-y border-line py-5">
      <ProductCategoryNav locale={locale} current={category.id} />
    </div>
    <div
      class="mt-9 grid gap-5 sm:grid-cols-2 lg:grid-cols-3"
      aria-label={t("categories.productList", locale, { label })}
    >
      {products.map((product) => (
        <ProductCard locale={locale} product={product} />
      ))}
    </div>
  </Container>
</BaseLayout>
