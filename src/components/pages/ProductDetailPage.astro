---
import { localePath } from "../../i18n/routing";
import type { Locale } from "../../i18n/utils";
import FaqAccordion from "../FaqAccordion.astro";
import AddToInquiryButton from "../AddToInquiryButton.astro";
import Breadcrumbs from "../Breadcrumbs.astro";
import Button from "../Button.astro";
import Container from "../Container.astro";
import Eyebrow from "../Eyebrow.astro";
import InquiryForm from "../InquiryForm.astro";
import ProductCard from "../ProductCard.astro";
import ProductGallery from "../ProductGallery.astro";
import SectionHeading from "../SectionHeading.astro";
import { productMeta, productData, configuredOrigin } from "../../lib/seo";
import { site } from "../../config/site";
import { confirmedLocalized, t } from "../../i18n/utils";
import { productSpecifications } from "../../lib/product-specifications";
import {
  getProductCategory,
  inquiryProduct,
  type Product,
} from "../../lib/products";
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Props {
  locale?: Locale;
  product: Product;
  related: Product[];
}
const { product, related } = Astro.props;
const { data } = product;
const { locale = "en" } = Astro.props;
const category = await getProductCategory(data.category);
const categoryLabel = confirmedLocalized(category.label, locale) ?? category.id;
const inquiryEntry = inquiryProduct(data, locale);
const title = inquiryEntry.title;
const summary = confirmedLocalized(data.summary, locale);
const {
  rows: specificationRows,
  sizes,
  columns: visibleSizeColumns,
} = productSpecifications(data, site, locale);
const customization =
  typeof data.customizable === "boolean"
    ? t(
        data.customizable
          ? "products.customizationAvailable"
          : "products.customizationUnavailable",
        locale,
      )
    : undefined;
const colors = data.colors
  .map((value) => confirmedLocalized(value, locale))
  .filter(Boolean);
const patterns = data.patterns
  .map((value) => confirmedLocalized(value, locale))
  .filter(Boolean);
const options = [
  [t("products.colors", locale), colors],
  [t("products.patterns", locale), patterns],
] as const;
const bodySections = [
  [
    t("products.customOptions", locale),
    confirmedLocalized(data.customOptions, locale),
  ],
  [
    t("products.packaging", locale),
    confirmedLocalized(data.packagingDetails, locale),
  ],
  [
    t("products.applications", locale),
    confirmedLocalized(data.applications, locale),
  ],
].filter(([, value]) => value);
const faqs = data.faqs.flatMap(({ q, a }) => {
  const question = confirmedLocalized(q, locale);
  const answer = confirmedLocalized(a, locale);
  return question && answer ? [{ question, answer }] : [];
});
---

<BaseLayout
  locale={locale}
  {...productMeta(data, locale)}
  structuredData={productData(
    data,
    locale,
    new URL(
      Astro.url.pathname,
      configuredOrigin(site.domain) ?? Astro.url.origin,
    ).href,
  )}
>
  <Container class="py-8 sm:py-12">
    <Breadcrumbs
      locale={locale}
      items={[
        { label: t("breadcrumbs.home", locale), href: "/" },
        { label: t("breadcrumbs.products", locale), href: "/products/" },
        { label: categoryLabel, href: "/products/" + category.id + "/" },
        { label: title },
      ]}
    />

    <section
      class="mt-8 grid items-start gap-8 lg:grid-cols-2 lg:gap-12"
      aria-labelledby="product-title"
    >
      <ProductGallery locale={locale} images={data.images} title={title} />
      <div class="min-w-0 lg:py-3">
        <Eyebrow>{categoryLabel}</Eyebrow>
        <h1
          id="product-title"
          class="mt-5 font-display text-page-title font-normal wrap-anywhere"
        >
          {title}
        </h1>
        {inquiryEntry.sku && (
          <p
            data-product-model
            class="mt-4 text-xs font-semibold tracking-[0.12em] wrap-anywhere text-ink-soft uppercase"
          >
            {t("products.skuPrefix", locale)} {inquiryEntry.sku}
          </p>
        )}
        {summary && (
          <p class="mt-6 text-base leading-relaxed text-ink-soft">{summary}</p>
        )}
        <p class="mt-7 text-xs font-extrabold tracking-[0.14em] text-copper uppercase">
          {t("products.askPricing", locale)}
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <Button
            data-track="quote_button_click"
            href={localePath(
              "/contact/?product=" + encodeURIComponent(data.slug) + "#quote",
              locale,
            )}
          >
            {t("products.getQuote", locale)}
          </Button>
          <AddToInquiryButton
            locale={locale}
            product={inquiryEntry}
            class="min-h-12 px-5"
          />
        </div>
        <p class="mt-5 text-sm leading-relaxed text-ink-soft">
          {t("products.inquiryHelp", locale)}
        </p>
      </div>
    </section>

    {(specificationRows.length > 0 || sizes.length > 0) && (
      <section
        class="mt-14 border-t border-line pt-10 sm:mt-20"
        aria-labelledby="specifications-title"
      >
        <SectionHeading
          eyebrow={t("products.detailsEyebrow", locale)}
          title={t("products.specifications", locale)}
          id="specifications-title"
        />
        {specificationRows.length > 0 && (
          <dl class="mt-7 grid gap-px overflow-hidden rounded-panel border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
            {specificationRows.map(([label, value]) => (
              <div class="min-w-0 bg-white p-5">
                <dt class="text-[0.6875rem] font-bold tracking-[0.1em] text-ink-soft uppercase">
                  {label}
                </dt>
                <dd class="mt-2 text-sm leading-relaxed wrap-anywhere">
                  {value}
                </dd>
              </div>
            ))}
          </dl>
        )}
        {sizes.length > 0 && (
          <>
            <h3 class="mt-8 font-display text-card-title font-normal">
              {t("products.sizes", locale)}
            </h3>
            <div
              data-size-table
              role="region"
              aria-label={t("products.sizeRegion", locale)}
              tabindex="0"
              class="mt-4 max-w-full overflow-x-auto rounded-panel border border-line bg-white"
            >
              <table
                class:list={[
                  "w-full border-collapse text-left text-sm",
                  visibleSizeColumns.length >= 3 && "min-w-[34rem]",
                ]}
              >
                <caption class="sr-only">
                  {t("products.dimensionsCaption", locale)}
                </caption>
                <thead class="border-b border-line bg-paper text-xs text-ink-soft">
                  <tr>
                    {visibleSizeColumns.map(([, label]) => (
                      <th scope="col" class="px-5 py-4 font-bold">
                        {t(label, locale)}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {sizes.map((size) => (
                    <tr class="border-b border-line last:border-b-0">
                      {visibleSizeColumns.map(([field]) =>
                        field === "name" && size.name ? (
                          <th scope="row" class="px-5 py-4 font-semibold">
                            {size.name}
                          </th>
                        ) : (
                          <td class="px-5 py-4 wrap-anywhere">{size[field]}</td>
                        ),
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )}
      </section>
    )}

    {(colors.length > 0 || patterns.length > 0 || customization) && (
      <section
        class="mt-10 grid gap-5 sm:grid-cols-3"
        aria-label={t("products.availableOptions", locale)}
      >
        {options.map(
          ([label, values]) =>
            values.length > 0 && (
              <div class="min-w-0 rounded-panel border border-line bg-white p-5">
                <h2 class="font-display text-card-title font-normal">
                  {label}
                </h2>
                <ul class="mt-3 grid gap-2 text-sm leading-relaxed text-ink-soft">
                  {values.map((value) => (
                    <li>{value}</li>
                  ))}
                </ul>
              </div>
            ),
        )}
        {customization && (
          <div class="min-w-0 rounded-panel border border-line bg-white p-5">
            <h2 class="font-display text-card-title font-normal">
              {t("products.customization", locale)}
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-ink-soft">
              {customization}
            </p>
          </div>
        )}
      </section>
    )}

    {bodySections.length > 0 && (
      <div class="product-body mt-10 max-w-3xl border-t border-line pt-2">
        {bodySections.map(([heading, value]) => (
          <section>
            <h2>{heading}</h2>
            <p class="whitespace-pre-line">{value}</p>
          </section>
        ))}
      </div>
    )}

    {faqs.length > 0 && (
      <section
        class="mt-12 border-t border-line pt-10"
        aria-labelledby="product-faq-title"
      >
        <SectionHeading
          eyebrow={t("products.beforeOrder", locale)}
          title={t("products.questions", locale)}
          id="product-faq-title"
        />
        <FaqAccordion class="mt-7" items={faqs} />
      </section>
    )}

    {related.length > 0 && (
      <section
        class="mt-14 border-t border-line pt-10"
        aria-labelledby="related-title"
      >
        <SectionHeading
          eyebrow={t("products.relatedEyebrow", locale)}
          title={t("products.related", locale)}
          id="related-title"
        />
        <div class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {related.map((item) => (
            <ProductCard locale={locale} product={item} />
          ))}
        </div>
      </section>
    )}
  </Container>
  <section
    id="quote"
    class="border-y border-line bg-paper py-14 sm:py-20"
    aria-labelledby="product-quote-title"
  >
    <Container class="max-w-5xl">
      <div class="rounded-panel border border-line bg-white p-6 sm:p-10">
        <SectionHeading
          id="product-quote-title"
          eyebrow={t("contact.quoteEyebrow", locale)}
          title={t("contact.quoteTitle", locale)}
          description={t("contact.quoteDescription", locale)}
        />
        <InquiryForm locale={locale} productSlug={data.slug} />
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .product-body :global(h2) {
    margin-top: 2rem;
    font-family: var(--font-display);
    font-size: var(--text-card-title);
    font-weight: 400;
    line-height: 1.15;
  }
  .product-body :global(p),
  .product-body :global(ul),
  .product-body :global(ol) {
    margin-top: 1rem;
    color: var(--color-ink-soft);
    line-height: 1.75;
    overflow-wrap: anywhere;
  }
  .product-body :global(ul),
  .product-body :global(ol) {
    padding-left: 1.25rem;
  }
  .product-body :global(ul) {
    list-style: disc;
  }
  .product-body :global(ol) {
    list-style: decimal;
  }
  .product-body :global(a) {
    color: var(--color-copper);
    text-decoration: underline;
  }
</style>
