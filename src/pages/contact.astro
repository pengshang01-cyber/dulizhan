---
import PagePlaceholder from "../components/PagePlaceholder.astro";
import { display } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact">
  <PagePlaceholder title="Contact" headingId="quote">
    <p
      id="privacy-policy"
      class="mt-7 w-fit rounded-control border border-line bg-white px-4 py-3 text-sm text-ink-soft target:border-copper target:bg-paper"
    >
      {display("TODO_PRIVACY_POLICY", "privacy policy")}
    </p>
  </PagePlaceholder>
</BaseLayout>
