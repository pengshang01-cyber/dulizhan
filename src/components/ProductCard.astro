---
import type { Locale } from "../i18n/utils";
import { Image } from "astro:assets";
import { confirmedLocalized, t } from "../i18n/utils";
import {
  getProductCategory,
  inquiryProduct,
  productHref,
  sizeSummary,
  type Product,
} from "../lib/products";
import AddToInquiryButton from "./AddToInquiryButton.astro";
interface Props {
  locale?: Locale;
  product: Product;
}
const { product } = Astro.props;
const { data } = product;
const { locale = "en" } = Astro.props;
const category = await getProductCategory(data.category);
const cover = data.images[0]!;
const inquiryEntry = inquiryProduct(data, locale);
const title = inquiryEntry.title;
const badge = confirmedLocalized(data.badge, locale);
const size = sizeSummary(data.sizes, locale);
---

<article
  class="relative isolate flex h-full min-w-0 flex-col rounded-panel border border-line bg-white transition-colors focus-within:border-copper hover:border-copper"
  data-product-card={data.slug}
>
  <div class="relative border-b border-line bg-paper">
    <Image
      src={cover}
      alt={t(
        cover.src.includes("placeholder")
          ? "products.imagePlaceholder"
          : "products.image",
        locale,
        { title },
      )}
      widths={[320, 640, 960]}
      sizes="(min-width: 80rem) 24rem, (min-width: 64rem) 31vw, (min-width: 640px) 46vw, calc(100vw - 2.5rem)"
      format="webp"
      loading="lazy"
      class="aspect-[5/4] w-full rounded-t-panel object-cover"
    />
    {badge && (
      <span
        data-product-badge
        class="pointer-events-none absolute top-3 left-3 z-20 max-w-[calc(100%-1.5rem)] rounded-control bg-coffee px-2.5 py-1.5 text-[0.625rem] font-bold tracking-[0.08em] wrap-anywhere text-cream uppercase"
      >
        {badge}
      </span>
    )}
  </div>
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <p class="text-[0.625rem] leading-relaxed font-semibold tracking-[0.12em] wrap-anywhere text-muted uppercase">
      {inquiryEntry.sku && inquiryEntry.sku + " / "}
      {confirmedLocalized(category.label, locale) ?? category.id}
    </p>
    <h2 class="mt-3 font-display text-card-title font-normal wrap-anywhere">
      <a
        href={productHref(data, locale)}
        class="after:absolute after:inset-0 after:z-10"
      >
        {title}
      </a>
    </h2>
    {size && <p class="mt-3 text-sm leading-relaxed text-ink-soft">{size}</p>}
    <p class="mt-5 text-[0.625rem] font-extrabold tracking-[0.14em] text-copper uppercase">
      {t("products.askPricing", locale)}
    </p>
    <div class="mt-auto pt-5">
      <AddToInquiryButton
        locale={locale}
        product={inquiryEntry}
        class="relative z-20 w-full"
      />
    </div>
  </div>
</article>
