---
import { getProducts } from "../lib/products";
import { localized } from "../i18n/utils";
import { localePath } from "../i18n/routing";
import type { Locale } from "../i18n/utils";
import { t } from "../i18n/utils";
const { locale = "en" } = Astro.props;
import Button from "./Button.astro";
import SectionHeading from "./SectionHeading.astro";
const catalog = (await getProducts()).map(({ data }) => ({
  slug: data.slug,
  sku: data.sku,
  title: localized(data.title, locale),
  category: data.category,
}));
interface Props {
  locale?: Locale;
}
---

<section
  data-inquiry-summary
  hidden
  aria-labelledby="inquiry-summary-title"
  class="mb-10"
>
  <SectionHeading
    id="inquiry-summary-title"
    eyebrow={t("inquiry.summaryEyebrow", locale)}
    title={t("inquiry.summaryTitle", locale)}
    description={t("inquiry.summaryDescription", locale)}
  />
  <p data-inquiry-summary-empty hidden class="mt-5 text-sm text-ink-soft">
    {t("inquiry.summaryEmpty", locale)}
  </p>
  <ul
    data-inquiry-summary-items
    data-inquiry-catalog={JSON.stringify(catalog)}
    aria-label={t("inquiry.summaryLabel", locale)}
    class="mt-6 grid gap-3"
  ></ul>
  <Button
    href={localePath("/inquiry/", locale)}
    variant="secondary"
    class="mt-5"
  >
    {t("inquiry.review", locale)}
  </Button>
</section>

<template id="inquiry-summary-template">
  <li
    data-inquiry-summary-item
    class="grid gap-4 rounded-panel border border-line bg-white p-5 sm:grid-cols-[minmax(0,1fr)_auto] sm:p-6"
  >
    <div class="min-w-0">
      <p
        data-inquiry-summary-sku
        class="text-xs tracking-[0.12em] wrap-anywhere text-muted uppercase"
      ></p>
      <h3 class="mt-2 font-display text-card-title font-normal wrap-anywhere">
        <a data-inquiry-summary-product class="hover:text-copper"></a>
      </h3>
    </div>
    <div class="sm:text-right">
      <p class="text-xs font-bold tracking-[0.06em] uppercase">
        {t("inquiry.quantity", locale)}
      </p>
      <p data-inquiry-summary-quantity class="mt-2 text-sm text-ink-soft"></p>
    </div>
  </li>
</template>

<script>
  import { localePath } from "../i18n/routing";
  import { readInquiryCatalog, inquiryDisplayItem } from "../lib/inquiry-view";
  import { t } from "../i18n/utils";
  const locale = document.documentElement.lang === "zh-CN" ? "zh" : "en";
  import { display } from "../config/site";
  import { getItems, INQUIRY_CHANGE_EVENT } from "../lib/inquiry";

  const summary = document.querySelector<HTMLElement>("[data-inquiry-summary]");
  const list = document.querySelector<HTMLUListElement>(
    "[data-inquiry-summary-items]",
  );
  const empty = document.querySelector<HTMLElement>(
    "[data-inquiry-summary-empty]",
  );
  const template = document.querySelector<HTMLTemplateElement>(
    "#inquiry-summary-template",
  );

  const catalog = readInquiryCatalog(list?.dataset.inquiryCatalog);

  function renderSummary() {
    if (!summary || !list || !empty || !template) return;
    const requested =
      new URLSearchParams(window.location.search).get("from") === "inquiry";
    summary.hidden = !requested;
    if (!requested) return;
    const items = getItems().map((item) => inquiryDisplayItem(item, catalog));
    empty.hidden = items.length > 0;
    list.hidden = items.length === 0;
    const fragment = document.createDocumentFragment();
    for (const item of items) {
      const row = template.content.firstElementChild?.cloneNode(true) as
        HTMLLIElement | undefined;
      if (!row) continue;
      row.dataset.slug = item.slug;
      const product = row.querySelector<HTMLAnchorElement>(
        "[data-inquiry-summary-product]",
      );
      const sku = row.querySelector<HTMLElement>("[data-inquiry-summary-sku]");
      const quantity = row.querySelector<HTMLElement>(
        "[data-inquiry-summary-quantity]",
      );
      if (product) {
        product.textContent = display(
          item.title,
          t("inquiry.productName", locale),
        );
        product.href = localePath(
          `/products/${encodeURIComponent(item.category)}/${encodeURIComponent(item.slug)}/`,
          locale,
        );
      }
      if (sku)
        sku.textContent = t("inquiry.sku", locale, {
          sku: display(item.sku, t("inquiry.skuLabel", locale)),
        });
      if (quantity) {
        quantity.textContent =
          item.quantity === null
            ? t("inquiry.toDiscuss", locale)
            : t("inquiry.quantityPcs", locale, {
                quantity: item.quantity.toLocaleString(
                  { en: "en-US", zh: "zh-CN" }[locale],
                ),
              });
      }
      fragment.append(row);
    }
    list.replaceChildren(fragment);
  }

  window.addEventListener(INQUIRY_CHANGE_EVENT, renderSummary);
  window.addEventListener("pageshow", renderSummary);
  renderSummary();
</script>
