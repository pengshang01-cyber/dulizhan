---
import { Image } from "astro:assets";
import { site } from "../config/site";
import { confirmedLocalized, t, type Locale } from "../i18n/utils";
import { confirmedText } from "../lib/placeholders";
import { resolveSiteImage } from "../lib/site-images";
import Container from "./Container.astro";
import OemOdmDetails from "./OemOdmDetails.astro";
import SectionHeading from "./SectionHeading.astro";
import StatsBar from "./StatsBar.astro";

interface Props {
  locale: Locale;
  certificateId: string;
}
const { locale, certificateId } = Astro.props;
const profile = site.factoryProfile;
const steps = [
  "trust.inquiry",
  "trust.sample",
  "trust.approval",
  "trust.production",
  "trust.quality",
  "trust.dispatch",
] as const;
const regions = profile.exportRegions.flatMap((value) => {
  const name = confirmedLocalized(value, locale);
  return name ? [name] : [];
});
const area = confirmedText(profile.areaSqM);
const metrics = [
  [
    t("trust.area", locale),
    area ? t("trust.areaValue", locale, { value: area }) : undefined,
  ],
  [t("trust.people", locale), confirmedText(profile.employeeCount)],
  [t("trust.lines", locale), confirmedText(profile.productionLineCount)],
  [t("trust.regions", locale), regions.join(locale === "zh" ? "、" : ", ")],
].filter(([, value]) => value);
const quality = confirmedLocalized(profile.qualityControl, locale);
const photos = (entries: typeof profile.tradeShowPhotos) =>
  entries.flatMap(({ image, caption }) => {
    const name = confirmedLocalized(caption, locale);
    const asset = resolveSiteImage(image);
    return name && asset ? [{ name, asset }] : [];
  });
const galleries = [
  {
    title: t("trust.exhibitions", locale),
    images: photos(profile.tradeShowPhotos),
    logo: false,
  },
  {
    title: t("trust.clients", locale),
    images: photos(profile.clientLogos),
    logo: true,
  },
].filter(({ images }) => images.length);
const certificates = photos(
  site.certificates.map(({ name, imagePath }) => ({
    caption: name,
    image: imagePath,
  })),
);
---

<section
  data-factory-trust
  aria-labelledby="factory-trust-title"
  class="border-y border-line bg-paper py-12 sm:py-16"
>
  <Container class="pb-7">
    <SectionHeading
      id="factory-trust-title"
      eyebrow={t("trust.eyebrow", locale)}
      title={t("trust.title", locale)}
      description={t("trust.description", locale)}
    />
  </Container>
  <StatsBar locale={locale} />
  <Container class="pt-7">
    <OemOdmDetails locale={locale} />
    <h3 class="mt-8 font-display text-card-title font-normal">
      {t("trust.workflow", locale)}
    </h3>
    <ol
      data-production-steps
      class="mt-4 grid gap-2 sm:grid-cols-3 lg:grid-cols-6"
    >
      {steps.map((step, index) => (
        <li class="flex min-w-0 items-center gap-3 rounded-panel border border-line bg-white px-4 py-3 sm:items-start lg:block">
          <span
            aria-hidden="true"
            class="font-display text-2xl leading-none text-copper-dark"
          >
            {String(index + 1).padStart(2, "0")}
          </span>
          <span class="text-sm leading-snug font-semibold text-ink lg:mt-2 lg:block">
            {t(step, locale)}
          </span>
        </li>
      ))}
    </ol>

    {metrics.length > 0 && (
      <dl
        data-factory-profile
        class="mt-8 grid gap-px overflow-hidden rounded-panel border border-line bg-line sm:grid-cols-2"
      >
        {metrics.map(([label, value]) => (
          <div class="bg-white p-5">
            <dt class="text-sm font-semibold">{label}</dt>
            <dd class="mt-2 text-sm text-ink-soft">{value}</dd>
          </div>
        ))}
      </dl>
    )}
    {quality && (
      <div
        data-quality-control
        class="mt-8 rounded-panel border border-line bg-white p-5"
      >
        <h3 class="font-display text-card-title font-normal">
          {t("trust.qualityNotes", locale)}
        </h3>
        <p class="mt-2 text-sm leading-relaxed whitespace-pre-line text-ink-soft">
          {quality}
        </p>
      </div>
    )}
    {galleries.map(({ title, images, logo }) => (
      <div class="mt-8" data-factory-gallery>
        <h3 class="font-display text-card-title font-normal">{title}</h3>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {images.map(({ name, asset }) => (
            <li class="overflow-hidden rounded-panel border border-line bg-white">
              <Image
                src={asset}
                alt={name}
                widths={[400, 720]}
                sizes="(min-width: 64rem) 28vw, (min-width: 40rem) 45vw, 90vw"
                format="webp"
                class:list={[
                  "aspect-[4/3] w-full",
                  logo ? "object-contain p-5" : "object-cover",
                ]}
              />
              <p class="px-4 py-3 text-sm">{name}</p>
            </li>
          ))}
        </ul>
      </div>
    ))}
    {certificates.length > 0 && (
      <div id={certificateId} data-certificates class="mt-8">
        <h3 class="font-display text-card-title font-normal">
          {t("pages.about.factory_certificates", locale)}
        </h3>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {certificates.map(({ name, asset }) => (
            <li class="rounded-panel border border-line bg-white p-5">
              <Image
                src={asset}
                alt={name}
                width={480}
                format="webp"
                class="aspect-[4/3] w-full object-contain"
              />
              <p class="mt-3 text-sm font-semibold">{name}</p>
            </li>
          ))}
        </ul>
      </div>
    )}
  </Container>
</section>
