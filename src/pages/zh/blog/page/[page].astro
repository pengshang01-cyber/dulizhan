---
import BlogPage from "../../../../components/pages/BlogPage.astro";
import { getBlogPosts } from "../../../../lib/blog";
import { blogPageCount } from "../../../../lib/blog-rules";
export async function getStaticPaths() {
  return Array.from(
    { length: blogPageCount((await getBlogPosts("zh")).length) - 1 },
    (_, i) => ({ params: { page: String(i + 2) }, props: { page: i + 2 } }),
  );
}
const { page } = Astro.props;
---

<BlogPage locale="zh" page={page} />
