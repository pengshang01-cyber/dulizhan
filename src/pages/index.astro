---
import { Image } from "astro:assets";
import heroPlaceholder from "../assets/images/home/hero-placeholder.png";
import Button from "../components/Button.astro";
import CheckList from "../components/CheckList.astro";
import Container from "../components/Container.astro";
import DisplayHeading from "../components/DisplayHeading.astro";
import Eyebrow from "../components/Eyebrow.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import { customizationSteps as steps } from "../data/customization";
import QuoteButton from "../components/QuoteButton.astro";
import SectionHeading from "../components/SectionHeading.astro";
import StatsBar from "../components/StatsBar.astro";
import CategoryGrid from "../components/home/CategoryGrid.astro";
import FactoryVideo from "../components/home/FactoryVideo.astro";
import { isTodo, site } from "../config/site";
import { faqs } from "../data/faq";
import BaseLayout from "../layouts/BaseLayout.astro";

const intro =
  "Bulk orders and custom printing for bakeries, packaging distributors, and food brands.";
const benefits = [
  {
    title: "Wide Range of Prints & Colors",
    description:
      "Choose from a broad library of patterns, solid colors and seasonal designs, or bring your own artwork.",
    icon: "M4 4h6v6H4z M14 4h6v6h-6z M4 14h6v6H4z M14 14h6v6h-6z",
  },
  {
    title: "Food-Grade Paper",
    description:
      "Made from food-grade, grease-resistant paper. Material documents are available on request.",
    icon: "m12 3 7 3v5c0 4-2.6 7.4-7 10-4.4-2.6-7-6-7-10V6l7-3Z M9 12l2 2 4-4",
  },
  {
    title: "Factory-Direct Pricing",
    description:
      "Buy straight from the production line with pricing built for wholesale volumes.",
    icon: "M4 8h16v12H4z M3 4h18v4H3z M9 12h6",
  },
  {
    title: "Custom Logo, Size & Color",
    description:
      "Print your logo, match your brand colors and choose the size and packaging you need.",
    icon: "m4 16 11-11a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z M13 7l4 4 M13 20h8",
  },
];

const videoId = site.youtubeVideoId.trim();
const hasVideo = !isTodo(videoId) && /^[A-Za-z0-9_-]{11}$/.test(videoId);
const certificates = site.certificates.filter(
  ({ name, imagePath }) =>
    name.trim() &&
    imagePath.trim() &&
    !isTodo(name.trim()) &&
    !isTodo(imagePath.trim()),
);
const featuredFaqs = faqs.filter(({ featured }) => featured);
---

<BaseLayout
  title="Cupcake Liners & Baking Cups Manufacturer"
  description={intro}
>
  <section id="home-hero" aria-labelledby="hero-title">
    <Container class="grid items-center gap-8 py-10 sm:gap-12 sm:py-16 lg:grid-cols-[1.1fr_1fr] lg:gap-14 lg:py-20">
      <div class="min-w-0">
        <Eyebrow class="mb-5">Wholesale baking essentials</Eyebrow>
        <DisplayHeading
          id="hero-title"
          first="Cupcake Liners & Baking Cups"
          second="Made Factory Direct."
        />
        <p class="mt-5 max-w-lg text-base leading-relaxed text-ink-soft sm:mt-6 sm:text-lg">
          {intro}
        </p>
        <div class="mt-6 flex flex-wrap gap-3 sm:mt-8">
          <QuoteButton />
          <Button href="/products/" variant="secondary">
            View Products
          </Button>
        </div>
        <CheckList
          items={["Food-grade paper", "Custom printing & OEM"]}
          class="mt-6 text-ink-soft sm:flex sm:flex-wrap sm:gap-x-6"
        />
      </div>
      <div class="rounded-panel border border-line bg-paper p-2 shadow-panel sm:p-3">
        <Image
          src={heroPlaceholder}
          alt="Hero product image placeholder"
          widths={[384, 648, 960, 1200]}
          sizes="(min-width: 80rem) 35rem, (min-width: 64rem) 46vw, calc(100vw - 2.5rem)"
          format="webp"
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/3] w-full rounded-control object-cover"
        />
      </div>
    </Container>
  </section>

  <StatsBar />
  <CategoryGrid />

  <section
    aria-labelledby="benefits-title"
    class="border-y border-line bg-paper py-14 sm:py-20"
  >
    <Container>
      <SectionHeading
        eyebrow="The factory advantage"
        title="Why Buyers Choose Us"
        id="benefits-title"
      />
      <ul class="mt-8 grid gap-x-5 gap-y-8 min-[340px]:grid-cols-2 sm:gap-x-8 lg:grid-cols-4">
        {benefits.map(({ title, description, icon }) => (
          <li class="border-t border-line pt-6">
            <span
              aria-hidden="true"
              class="grid size-11 place-items-center rounded-control border border-copper text-copper"
            >
              <svg
                viewBox="0 0 24 24"
                class="size-6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d={icon}></path>
              </svg>
            </span>
            <h3 class="mt-4 font-display text-xl leading-tight font-normal sm:text-card-title">
              {title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-soft">
              {description}
            </p>
          </li>
        ))}
      </ul>
    </Container>
  </section>

  <section aria-labelledby="custom-title" class="dark-surface py-14 sm:py-20">
    <Container>
      <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-end sm:justify-between">
        <SectionHeading
          eyebrow="Custom printing & OEM"
          title="Custom Printing"
          id="custom-title"
          description="Work through the design and sample before confirming your production order."
        />
        <Button href="/custom/" variant="secondary" class="shrink-0">
          Explore Custom/OEM <span aria-hidden="true">→</span>
        </Button>
      </div>
      <ol class="mt-9 grid gap-3 min-[340px]:grid-cols-2 sm:gap-5 lg:grid-cols-4">
        {steps.map(({ title, description }, index) => (
          <li class="rounded-panel border border-line bg-white p-4 text-ink sm:p-6">
            <span
              aria-hidden="true"
              class="font-display text-3xl leading-none text-copper"
            >
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-4 font-display text-xl leading-tight font-normal sm:text-card-title">
              {title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-soft">
              {description}
            </p>
          </li>
        ))}
      </ol>
    </Container>
  </section>

  {hasVideo && <FactoryVideo videoId={videoId} />}

  {certificates.length > 0 && (
    <section
      id="certificates"
      aria-labelledby="certificates-title"
      class="border-b border-line py-14 sm:py-20"
    >
      <Container>
        <SectionHeading
          eyebrow="Quality documentation"
          title="Factory Certificates"
          id="certificates-title"
        />
        <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {certificates.map(({ name, imagePath }) => (
            <li>
              <figure class="h-full rounded-panel border border-line bg-white p-4">
                <img
                  src={imagePath}
                  alt={name}
                  width="480"
                  height="360"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/3] w-full object-contain"
                />
                <figcaption class="mt-3 text-sm font-bold">{name}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </Container>
    </section>
  )}

  <section
    id="home-faq"
    aria-labelledby="home-faq-title"
    class="border-b border-line py-14 sm:py-20"
  >
    <Container class="grid items-start gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:gap-16">
      <SectionHeading
        eyebrow="Before you order"
        title="Frequently Asked Questions"
        id="home-faq-title"
      />
      <FaqAccordion items={featuredFaqs} firstOpen />
    </Container>
  </section>

  <section
    aria-labelledby="home-quote-title"
    class="dark-surface border-b border-sand/20 py-14 sm:py-20"
  >
    <Container class="flex flex-col items-start gap-7 lg:flex-row lg:items-center lg:justify-between">
      <SectionHeading
        eyebrow="Let's talk about your next order"
        title="Request a Factory Quote"
        id="home-quote-title"
        description="Send your preferred cup style, dimensions, order quantity, and print requirements."
      />
      <QuoteButton class="shrink-0" />
    </Container>
  </section>
</BaseLayout>
