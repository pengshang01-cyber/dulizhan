{
  "name": "dulizhan",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "junbeili.com", "custom_domain": true },
    { "pattern": "www.junbeili.com", "custom_domain": true },
  ],
  "previews": {},
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
