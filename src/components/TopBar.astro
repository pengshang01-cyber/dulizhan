---
import { isTodo, site } from "../config/site";
import Container from "./Container.astro";

const items = site.topBarItems
  .map((item) => item.trim())
  .filter((item) => item && !isTodo(item));
---

{items.length > 0 && (
  <div data-top-bar class="bg-coffee text-cream">
    <Container>
      <ul
        aria-label="Factory highlights"
        class="flex min-h-8 flex-wrap items-center justify-center gap-x-8 gap-y-2 py-2 text-center text-[0.625rem] leading-relaxed font-semibold tracking-[0.16em] uppercase sm:gap-x-12"
      >
        {items.map((item, index) => (
          <li class:list={[index > 0 && "hidden sm:block"]}>{item}</li>
        ))}
      </ul>
    </Container>
  </div>
)}
