---
import { t, confirmedLocalized, type Locale } from "../i18n/utils";
interface Props {
  locale?: Locale;
  languagePaths?: Partial<Record<Locale, string>>;
}
const { locale = "en", languagePaths } = Astro.props;
import { localePath, unlocalizedPath } from "../i18n/routing";
import LanguageSwitch from "./LanguageSwitch.astro";
import { Image } from "astro:assets";
import { resolveSiteImage } from "../lib/site-images";
import { navigation, site } from "../config/site";
import Container from "./Container.astro";
import QuoteButton from "./QuoteButton.astro";
import InquiryLink from "./InquiryLink.astro";

const logoImage = resolveSiteImage(site.logo);
const brand =
  confirmedLocalized(site.shortName, locale) ??
  confirmedLocalized(site.companyName, locale);
const current = unlocalizedPath(Astro.url.pathname).replace(/\/?$/, "/");
---

<header class="sticky top-0 z-30 border-b border-line bg-cream/95 backdrop-blur-md">
  <Container class="flex min-h-18 items-center justify-between gap-2.5 py-3">
    <a
      href={localePath("/", locale)}
      class="flex min-w-0 shrink-0 items-center gap-2.5"
    >
      <span class="sr-only">{t("nav.home", locale)}</span>
      {logoImage ? (
        <Image
          src={logoImage}
          alt=""
          width={256}
          format="png"
          loading="eager"
          data-site-logo
          class="h-12 w-auto shrink-0 object-contain lg:h-18"
        />
      ) : (
        <span class="brand-mark hidden sm:grid" aria-hidden="true"></span>
      )}
      {!logoImage && brand && (
        <span class="block text-base leading-tight font-bold">{brand}</span>
      )}
    </a>

    <nav aria-label={t("nav.main", locale)} class="hidden shrink-0 lg:block">
      <ul class="flex items-center gap-1">
        {navigation.map(({ key, href }) => (
          <li>
            <a
              href={localePath(href, locale)}
              aria-current={
                current === href || (href !== "/" && current.startsWith(href))
                  ? "page"
                  : undefined
              }
              class="inline-flex min-h-10 items-center border-b border-transparent px-1 text-[1.0625rem] font-semibold whitespace-nowrap text-ink-soft transition-colors hover:text-copper aria-[current=page]:border-copper aria-[current=page]:text-copper xl:px-2"
            >
              {t(key, locale)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <LanguageSwitch
        locale={locale}
        paths={languagePaths}
        class="hidden sm:flex"
      />
      <InquiryLink locale={locale} />
      <QuoteButton locale={locale} class="shrink-0" />
      <details class="group lg:hidden" data-mobile-menu>
        <summary class="grid size-11 cursor-pointer list-none place-items-center rounded-control border border-line text-ink hover:bg-paper group-open:bg-paper [&::-webkit-details-marker]:hidden">
          <span class="sr-only">{t("nav.menu", locale)}</span>
          <span aria-hidden="true" class="relative block h-3.5 w-4.5">
            <span class="absolute inset-x-0 top-0 h-0.5 rounded-full bg-current group-open:translate-y-1.5 group-open:rotate-45"></span>
            <span class="absolute inset-x-0 top-1.5 h-0.5 rounded-full bg-current group-open:opacity-0"></span>
            <span class="absolute inset-x-0 top-3 h-0.5 rounded-full bg-current group-open:-translate-y-1.5 group-open:-rotate-45"></span>
          </span>
        </summary>
        <nav
          aria-label={t("nav.mobile", locale)}
          class="absolute inset-x-0 top-full max-h-[calc(100dvh-6rem)] overflow-y-auto border-b border-line bg-cream shadow-panel"
        >
          <Container class="py-3">
            <LanguageSwitch
              locale={locale}
              paths={languagePaths}
              class="mb-3 border-b border-line px-3 pb-3"
            />
            <ul class="grid gap-0.5">
              {navigation.map(({ key, href }) => (
                <li>
                  <a
                    href={localePath(href, locale)}
                    aria-current={
                      current === href ||
                      (href !== "/" && current.startsWith(href))
                        ? "page"
                        : undefined
                    }
                    class="block w-fit border-b border-transparent px-3 py-2.5 text-base font-semibold hover:text-copper aria-[current=page]:border-copper aria-[current=page]:text-copper"
                  >
                    {t(key, locale)}
                  </a>
                </li>
              ))}
            </ul>
          </Container>
        </nav>
      </details>
    </div>
  </Container>
</header>
