---
import { t, localized } from "../i18n/utils";
const locale = "en";
import { getWhatsAppHref, site } from "../config/site";
import BrandIcon from "./BrandIcon.astro";

const href = getWhatsAppHref(
  site.whatsappNumber,
  localized(site.whatsappPrefillMessage, locale),
);
---

{href && (
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={t("site.whatsappChat", locale)}
    data-track="whatsapp_click"
    class="fixed right-4 bottom-4 z-30 grid size-13 place-items-center rounded-control bg-coffee text-white shadow-panel transition-colors hover:bg-coffee-2 motion-reduce:transition-none sm:right-6 sm:bottom-6"
  >
    <BrandIcon name="whatsapp" class="size-6" />
  </a>
)}
