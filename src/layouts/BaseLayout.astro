---
import { t, type Locale } from "../i18n/utils";
import { localeFromPath, localePath, unlocalizedPath } from "../i18n/routing";
import { site } from "../config/site";
import { getImage } from "astro:assets";
import { resolveSiteImage } from "../lib/site-images";
import { getProducts } from "../lib/products";
import {
  configuredOrigin,
  organizationData,
  staticPageMeta,
  type StructuredData,
} from "../lib/seo";
import JsonLd from "../components/JsonLd.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { measurementId } from "../lib/analytics";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import TopBar from "../components/TopBar.astro";
import ContactFloat from "../components/ContactFloat.astro";
import "../styles/global.css";

interface Props {
  locale?: Locale;
  title?: string;
  pagePath?: string;
  structuredData?: StructuredData;
  description?: string;
  canonical?: string | URL;
  og?: { title?: string; description?: string; image?: string; url?: string };
  noindex?: boolean;
  languagePaths?: Partial<Record<Locale, string>>;
  ogType?: "website" | "article";
}
const {
  locale = localeFromPath(Astro.url.pathname),
  title,
  description,
  canonical,
  og,
  noindex = false,
  pagePath = Astro.url.pathname,
  structuredData,
  languagePaths,
  ogType = "website",
} = Astro.props;
const defaults = staticPageMeta(pagePath, locale);
const pageTitle = title ?? defaults?.title;
const pageDescription = description ?? defaults?.description;
if (!pageTitle || !pageDescription)
  throw new Error("页面缺少 SEO 文案：" + pagePath);
const barePath = unlocalizedPath(pagePath);
const paths = languagePaths ?? {
  en: localePath(barePath, "en"),
  ...(barePath.replace(/\/$/, "") !== "/styleguide" && {
    zh: localePath(barePath, "zh"),
  }),
};
const origin = configuredOrigin(site.domain) ?? Astro.url.origin;
const canonicalUrl = new URL(canonical?.toString() ?? pagePath, origin).href;
const alternate = (language: Locale) => new URL(paths[language]!, origin).href;
const blockIndexing = !site.allowIndexing;
const logoSource = resolveSiteImage(site.logo);
const logo = logoSource
  ? await getImage({ src: logoSource, width: 256, format: "png" })
  : undefined;
const shareSource = resolveSiteImage(site.ogImage);
const defaultShareImage = shareSource
  ? await getImage({
      src: shareSource,
      width: 1200,
      height: 630,
      fit: "cover",
      format: "webp",
    })
  : undefined;
const defaultShareUrl =
  defaultShareImage && new URL(defaultShareImage.src, origin).href;
const shareImage = og?.image ? new URL(og.image, origin).href : defaultShareUrl;
const organization = organizationData(
  locale,
  site,
  logo && new URL(logo.src, origin).href,
  defaultShareUrl,
);
const publishedSlugs = (await getProducts())
  .map(({ data }) => data.slug)
  .join(" ");
---

<!doctype html>
<html
  lang={locale === "zh" ? "zh-CN" : "en"}
  data-inquiry-slugs={publishedSlugs}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={alternate("en")} />
    {paths.zh && (
      <link rel="alternate" hreflang="zh-CN" href={alternate("zh")} />
    )}
    <link rel="alternate" hreflang="x-default" href={alternate("en")} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={locale === "zh" ? "zh_CN" : "en_US"} />
    <meta property="og:title" content={og?.title ?? pageTitle} />
    <meta
      property="og:description"
      content={og?.description ?? pageDescription}
    />
    {shareImage && <meta property="og:image" content={shareImage} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={og?.title ?? pageTitle} />
    <meta
      name="twitter:description"
      content={og?.description ?? pageDescription}
    />
    {shareImage && <meta name="twitter:image" content={shareImage} />}
    <JsonLd data={organization} />
    <JsonLd data={structuredData} />
    {(noindex || blockIndexing) && (
      <meta
        name="robots"
        content={blockIndexing ? "noindex, nofollow" : "noindex"}
      />
    )}
  </head>
  <body class="flex min-h-screen flex-col bg-cream font-sans text-ink antialiased">
    <a
      href="#main-content"
      class="sr-only font-semibold focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-40 focus:rounded-control focus:bg-white focus:px-4 focus:py-3"
    >
      {t("pages.baselayout.skip_to_content", locale)}
    </a>
    <TopBar locale={locale} />
    <Header locale={locale} languagePaths={paths} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <ContactFloat locale={locale} />
    {measurementId(site.analytics.gaMeasurementId) && (
      <CookieConsent locale={locale} />
    )}
  </body>
</html>
