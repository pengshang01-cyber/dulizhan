---
import { display, navigation, site } from "../config/site";
import Container from "./Container.astro";
import QuoteButton from "./QuoteButton.astro";

const brand = display(site.shortName, "company short name");
const current = Astro.url.pathname.replace(/\/?$/, "/");
---

<header class="relative z-20 border-b border-line bg-surface">
  <Container class="flex min-h-18 items-center justify-between gap-2.5 py-3 lg:gap-4">
    <a
      href="/"
      aria-label={brand + " home"}
      class="flex min-w-0 items-center gap-2.5"
    >
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="text-[0.8125rem] leading-tight font-bold wrap-anywhere sm:text-sm">
        {brand}
      </span>
    </a>

    <nav aria-label="Main" class="hidden shrink-0 lg:block">
      <ul class="flex items-center gap-0.5 xl:gap-1">
        {navigation.map(({ label, href }) => (
          <li>
            <a
              href={href}
              aria-current={current === href ? "page" : undefined}
              class="inline-flex min-h-10 items-center rounded-control px-2.5 text-sm font-semibold text-muted hover:bg-canvas hover:text-ink aria-[current=page]:bg-primary-soft aria-[current=page]:text-primary xl:px-3"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <QuoteButton class="shrink-0" />
      <details class="group lg:hidden" data-mobile-menu>
        <summary class="grid size-11 cursor-pointer list-none place-items-center rounded-control border border-line text-ink hover:bg-canvas group-open:bg-primary-soft [&::-webkit-details-marker]:hidden">
          <span class="sr-only">Menu</span>
          <span aria-hidden="true" class="relative block h-3.5 w-4.5">
            <span class="absolute inset-x-0 top-0 h-0.5 rounded-full bg-current group-open:translate-y-1.5 group-open:rotate-45"></span>
            <span class="absolute inset-x-0 top-1.5 h-0.5 rounded-full bg-current group-open:opacity-0"></span>
            <span class="absolute inset-x-0 top-3 h-0.5 rounded-full bg-current group-open:-translate-y-1.5 group-open:-rotate-45"></span>
          </span>
        </summary>
        <nav
          aria-label="Mobile"
          class="absolute inset-x-0 top-full border-b border-line bg-surface shadow-panel"
        >
          <Container class="py-3">
            <ul class="grid gap-0.5">
              {navigation.map(({ label, href }) => (
                <li>
                  <a
                    href={href}
                    aria-current={current === href ? "page" : undefined}
                    class="block rounded-control px-3 py-2.5 text-sm font-semibold hover:bg-canvas aria-[current=page]:bg-primary-soft aria-[current=page]:text-primary"
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </Container>
        </nav>
      </details>
    </div>
  </Container>
</header>
