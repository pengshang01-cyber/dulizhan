---
import { Image } from "astro:assets";
import Button from "../components/Button.astro";
import CheckList from "../components/CheckList.astro";
import Container from "../components/Container.astro";
import DisplayHeading from "../components/DisplayHeading.astro";
import Eyebrow from "../components/Eyebrow.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import QuoteButton from "../components/QuoteButton.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { display, site } from "../config/site";
import { customizationCases } from "../data/cases";
import { customizationSteps } from "../data/customization";
import BaseLayout from "../layouts/BaseLayout.astro";

const options = [
  {
    title: "Your Logo",
    description:
      "We print your logo on baking cups. Send us your artwork to start the design review.",
  },
  {
    title: "Cup Size",
    description:
      "We support custom sizing. Share your base diameter, height and preferred cup style.",
  },
  {
    title: "Brand Colors",
    description:
      "We work with your brand colors. Share your color references so we can review them together.",
  },
  {
    title: "Prints & Patterns",
    description:
      "We offer a broad range of prints and seasonal designs, and we can work with your own pattern.",
  },
  {
    title: "Packaging",
    description:
      "We support custom packaging. Tell us how you want your cups packed and presented.",
  },
];
const policies = [
  { label: "Stock MOQ", value: site.stockMoq },
  { label: "Custom MOQ", value: site.customMoq },
  { label: "Sample Lead Time", value: site.sampleLeadTime },
  { label: "Production Lead Time", value: site.productionLeadTime },
  { label: "Sample Policy", value: site.sampleCost },
  { label: "Payment Terms", value: site.paymentTerms },
  { label: "Shipping Methods", value: site.shippingMethods },
];
const process = customizationSteps.map(({ title, description }, index) => ({
  question: `${String(index + 1).padStart(2, "0")} / ${title}`,
  answer: description,
}));
---

<BaseLayout
  title="Custom Printed Baking Cups & OEM"
  description="We customize baking cups with your logo, size, colors, patterns and packaging. Explore the process and plan your wholesale order."
>
  <section aria-labelledby="custom-hero-title" class="border-b border-line">
    <Container class="grid items-center gap-9 py-12 sm:py-20 lg:grid-cols-[1.25fr_0.75fr] lg:gap-16">
      <div>
        <Eyebrow class="mb-5">Custom printing & OEM</Eyebrow>
        <DisplayHeading
          id="custom-hero-title"
          first="Baking Cups,"
          second="Made for Your Brand."
        />
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-ink-soft sm:text-lg">
          We bring your logo, colors and ideas to food-grade paper baking cups,
          with factory-direct pricing for wholesale orders.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <QuoteButton />
          <Button href="/products/" variant="secondary">
            Explore Cup Styles
          </Button>
        </div>
      </div>
      <aside class="rounded-panel border border-line bg-white p-6 shadow-panel sm:p-8">
        <p class="text-xs font-bold tracking-[0.14em] text-copper uppercase">
          Start with your idea
        </p>
        <h2 class="mt-4 font-display text-card-title font-normal">
          What would you like to create?
        </h2>
        <CheckList
          class="mt-6 text-sm text-ink-soft"
          items={[
            "Your logo or artwork",
            "Cup style and dimensions",
            "Preferred colors and packaging",
            "Quantity, if known, and destination",
          ]}
        />
      </aside>
    </Container>
  </section>

  <section
    aria-labelledby="custom-options-title"
    class="bg-paper py-14 sm:py-20"
  >
    <Container>
      <SectionHeading
        eyebrow="Your brand, your details"
        title="What We Can Customize"
        id="custom-options-title"
        description="We help you bring the individual details together in a baking cup that fits your brand."
      />
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {options.map(({ title, description }, index) => (
          <li class="rounded-panel border border-line bg-white p-6 sm:p-7">
            <span
              aria-hidden="true"
              class="grid size-10 place-items-center rounded-control border border-copper font-display text-xl text-copper"
            >
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-5 font-display text-card-title font-normal">
              {title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-soft">
              {description}
            </p>
          </li>
        ))}
      </ul>
    </Container>
  </section>

  <section
    aria-labelledby="custom-process-title"
    class="dark-surface py-14 sm:py-20"
  >
    <Container class="grid items-start gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <SectionHeading
        eyebrow="From artwork to order"
        title="The Custom Process"
        id="custom-process-title"
        description="We work through your design and sample with you before you confirm the production order. Open each step for the details."
      />
      <div class="text-ink">
        <FaqAccordion items={process} firstOpen />
      </div>
    </Container>
  </section>

  <section
    aria-labelledby="custom-policies-title"
    class="border-b border-line py-14 sm:py-20"
  >
    <Container>
      <SectionHeading
        eyebrow="Plan your order"
        title="Samples, Quantities & Timing"
        id="custom-policies-title"
        description="We will review the requirements for your selected cup style and artwork with you."
      />
      <dl class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {policies.map(({ label, value }) => (
          <div class="rounded-panel border border-line bg-white p-6">
            <dt class="text-xs font-bold tracking-[0.12em] text-muted uppercase">
              {label}
            </dt>
            <dd class="mt-4 text-base leading-relaxed wrap-anywhere text-ink-soft">
              {display(value, label.toLowerCase())}
            </dd>
          </div>
        ))}
      </dl>
    </Container>
  </section>

  {customizationCases.length > 0 && (
    <section
      id="custom-cases"
      aria-labelledby="custom-cases-title"
      class="bg-paper py-14 sm:py-20"
    >
      <Container>
        <SectionHeading
          eyebrow="Custom projects"
          title="Made to Order"
          id="custom-cases-title"
        />
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {customizationCases.map(({ title, summary, image, imageAlt }) => (
            <article class="overflow-hidden rounded-panel border border-line bg-white">
              <Image
                src={image}
                alt={imageAlt}
                widths={[384, 768]}
                sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, calc(100vw - 2.5rem)"
                format="webp"
                loading="lazy"
                class="aspect-[3/2] w-full object-cover"
              />
              <div class="p-6">
                <h3 class="font-display text-card-title font-normal">
                  {display(title, "case title")}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-ink-soft">
                  {display(summary, "case description")}
                </p>
              </div>
            </article>
          ))}
        </div>
      </Container>
    </section>
  )}

  <section
    aria-labelledby="custom-quote-title"
    class="dark-surface border-b border-sand/20 py-14 sm:py-20"
  >
    <Container class="flex flex-col items-start gap-7 lg:flex-row lg:items-center lg:justify-between">
      <SectionHeading
        eyebrow="Let's make it yours"
        title="Tell Us About Your Project"
        id="custom-quote-title"
        description="Share your artwork and preferred cup style. We will help you work through the details."
      />
      <QuoteButton class="shrink-0" />
    </Container>
  </section>
</BaseLayout>
