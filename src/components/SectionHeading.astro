---
interface Props {
  title: string;
  description?: string;
  level?: 1 | 2 | 3;
  id?: string;
}

const { title, description, level = 2, id } = Astro.props;
const Heading = { 1: "h1", 2: "h2", 3: "h3" }[level] as "h1" | "h2" | "h3";
const size = {
  1: "text-page-title",
  2: "text-section-title",
  3: "text-card-title",
}[level];
---

<Heading
  id={id}
  class:list={["font-display font-normal tracking-tight wrap-anywhere", size]}
>
  {title}
</Heading>
{description && (
  <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
    {description}
  </p>
)}
