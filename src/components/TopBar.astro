---
import type { Locale } from "../i18n/utils";
import { t, confirmedLocalized } from "../i18n/utils";
const { locale = "en" } = Astro.props;
import { site } from "../config/site";
import Container from "./Container.astro";

const items = site.topBarItems
  .map((item) => confirmedLocalized(item, locale))
  .filter(Boolean);
interface Props {
  locale?: Locale;
}
---

{items.length > 0 && (
  <div data-top-bar class="bg-coffee text-cream">
    <Container>
      <ul
        aria-label={t("site.highlights", locale)}
        class="flex min-h-8 flex-wrap items-center justify-center gap-x-8 gap-y-2 py-2 text-center text-[0.625rem] leading-relaxed font-semibold tracking-[0.16em] uppercase sm:gap-x-12"
      >
        {items.map((item, index) => (
          <li class:list={[index > 0 && "hidden sm:block"]}>{item}</li>
        ))}
      </ul>
    </Container>
  </div>
)}
