---
import { t, type Locale } from "../i18n/utils";
import { localeFromPath, localePath, unlocalizedPath } from "../i18n/routing";
import { site } from "../config/site";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import TopBar from "../components/TopBar.astro";
import ContactFloat from "../components/ContactFloat.astro";
import "../styles/global.css";

interface Props {
  locale?: Locale;
  title: string;
  description?: string;
  canonical?: string | URL;
  og?: { title?: string; description?: string; image?: string; url?: string };
  noindex?: boolean;
}
const {
  locale = localeFromPath(Astro.url.pathname),
  title,
  description,
  canonical,
  og,
  noindex = false,
} = Astro.props;
const barePath = unlocalizedPath(Astro.url.pathname);
const hasChinese = barePath.replace(/\/$/, "") !== "/styleguide";
const origin = Astro.site ?? new URL(site.domain);
const alternate = (language: Locale) =>
  new URL(localePath(barePath, language), origin).toString();
const blockIndexing = !site.allowIndexing;
---

<!doctype html>
<html lang={locale === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical.toString()} />}
    <link rel="alternate" hreflang="en" href={alternate("en")} />
    {hasChinese && (
      <link rel="alternate" hreflang="zh-CN" href={alternate("zh")} />
    )}
    <link rel="alternate" hreflang="x-default" href={alternate("en")} />
    {og?.title && <meta property="og:title" content={og.title} />}
    {og?.description && (
      <meta property="og:description" content={og.description} />
    )}
    {og?.image && <meta property="og:image" content={og.image} />}
    {og?.url && <meta property="og:url" content={og.url} />}
    {(noindex || blockIndexing) && (
      <meta
        name="robots"
        content={blockIndexing ? "noindex, nofollow" : "noindex"}
      />
    )}
  </head>
  <body class="flex min-h-screen flex-col bg-cream font-sans text-ink antialiased">
    <a
      href="#main-content"
      class="sr-only font-semibold focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-40 focus:rounded-control focus:bg-white focus:px-4 focus:py-3"
    >
      {t("pages.baselayout.skip_to_content", locale)}
    </a>
    <TopBar locale={locale} />
    <Header locale={locale} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <ContactFloat locale={locale} />
  </body>
</html>
