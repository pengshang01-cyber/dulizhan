---
import { t, type Locale } from "../../i18n/utils";
import { localePath } from "../../i18n/routing";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../Container.astro";
import DisplayHeading from "../DisplayHeading.astro";
import Eyebrow from "../Eyebrow.astro";
import Button from "../Button.astro";
import QuoteButton from "../QuoteButton.astro";
interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;
---

<BaseLayout locale={locale} pagePath={localePath("/404.html", locale)} noindex>
  <Container class="grid min-h-[65vh] items-center py-16 sm:py-24">
    <div class="max-w-3xl">
      <Eyebrow class="mb-6">{t("notFound.eyebrow", locale)}</Eyebrow>
      <DisplayHeading
        first={t("notFound.first", locale)}
        second={t("notFound.second", locale)}
      />
      <p class="mt-7 max-w-xl leading-relaxed text-ink-soft">
        {t("notFound.message", locale)}
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <Button href={localePath("/", locale)}>
          {t("notFound.home", locale)}
        </Button>
        <Button variant="secondary" href={localePath("/products/", locale)}>
          {t("notFound.products", locale)}
        </Button>
        <QuoteButton locale={locale} />
      </div>
    </div>
  </Container>
</BaseLayout>
