---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { confirmedLocalized, t, type Locale } from "../i18n/utils";
import type { ProductData } from "../lib/products";
import type { ProductTechnicalSpec } from "../lib/product-technical-schema";
import { modelOptions } from "../lib/product-model";

interface Props {
  spec: ProductTechnicalSpec;
  images: ProductData["images"];
  poster: ImageMetadata;
  locale: Locale;
  title: string;
}
const { spec, images: available, poster, locale, title } = Astro.props;
const photos = available
  .filter(
    (view) => !view.scene && !view.technicalDrawing && !view.sizeComparison,
  )
  .slice(0, 2);
const comparison = available.find((view) => view.sizeComparison);
const images = comparison ? [...photos, comparison] : photos;
const { colors, variants } = modelOptions(spec, locale);
const posterAlt = t("model.poster", locale, { product: title });
const media = [
  { src: poster, alt: posterAlt, label: t("model.tab", locale) },
  ...images.map((view, i) => ({
    src: view.image,
    alt: confirmedLocalized(view.alt, locale) ?? title,
    label: view.sizeComparison
      ? t("products.sizeComparison", locale)
      : t(i === 0 ? "model.photo" : "model.stack", locale),
  })),
];
---

<article
  data-model-gallery
  data-status="poster"
  data-load-error={t("model.fallback", locale)}
  data-ar-error={t("model.arFailed", locale)}
  aria-label={t("products.galleryViews", locale)}
  class="min-w-0"
>
  <div class="relative overflow-hidden rounded-panel border border-line bg-paper">
    {media.map(({ src, alt }, i) => (
      <figure data-model-panel hidden={i !== 0} class="relative m-0">
        <Image
          src={src}
          alt={alt}
          widths={[384, 720, 1200]}
          sizes="(min-width: 80rem) 36rem, (min-width: 1024px) 47vw, calc(100vw - 2.5rem)"
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : "auto"}
          format="webp"
          class="block aspect-square w-full object-contain"
        />
        {i === 0 && (
          <>
            <canvas
              data-model-canvas
              hidden
              tabindex="0"
              aria-label={t("model.canvasHelp", locale, { product: title })}
              class="absolute inset-0 block size-full touch-none cursor-grab focus-visible:outline-2 focus-visible:outline-copper active:cursor-grabbing"
            ></canvas>
            <button
              data-model-start
              type="button"
              class="absolute bottom-4 left-1/2 flex min-h-11 -translate-x-1/2 items-center gap-2 whitespace-nowrap rounded-control bg-coffee px-5 text-sm font-bold text-white hover:bg-coffee-2"
            >
              <svg
                width="17"
                height="17"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path d="m12 2 9 5v10l-9 5-9-5V7l9-5Z M3 7l9 5 9-5 M12 12v10" />
              </svg>
              <span>{t("model.open", locale)}</span>
              <span data-loading hidden>
                {t("model.loading", locale)}
              </span>
            </button>
          </>
        )}
        {images[i - 1]?.sizeComparison && (
          <figcaption class="border-t border-line bg-white px-4 py-2 text-sm text-ink-soft">
            {alt}
          </figcaption>
        )}
      </figure>
    ))}
  </div>
  <p
    data-model-message
    role="status"
    class="text-sm leading-relaxed text-ink-soft empty:hidden"
  ></p>
  <div
    class="mt-3 grid grid-cols-4 gap-2"
    aria-label={t("products.galleryViews", locale)}
  >
    {media.map(({ src, label }, i) => (
      <button
        type="button"
        data-model-tab={i}
        aria-pressed={i === 0}
        class="min-w-0 rounded-control border border-line bg-white p-1 text-ink-soft hover:border-copper aria-pressed:border-copper aria-pressed:text-copper-dark"
      >
        <Image
          src={src}
          width={96}
          height={54}
          fit="contain"
          format="webp"
          alt=""
          loading="lazy"
          class="mx-auto h-10 w-full object-contain sm:h-12"
        />
        <span class="block py-1 text-[.68rem] leading-tight font-semibold sm:text-xs">
          {label}
        </span>
      </button>
    ))}
  </div>
  <div
    data-model-controls
    hidden
    class="mt-3 space-y-3 rounded-panel border border-line bg-white p-3 text-sm"
  >
    <div class="flex flex-wrap items-center gap-2">
      <button
        data-model-reset
        type="button"
        class="min-h-10 rounded-control border border-line px-3 hover:border-copper"
      >
        {t("model.reset", locale)}
      </button>
      <button
        data-model-auto
        type="button"
        aria-pressed="false"
        class="min-h-10 rounded-control border border-line px-3 hover:border-copper aria-pressed:border-coffee aria-pressed:bg-coffee aria-pressed:text-white"
      >
        {t("model.auto", locale)}
      </button>
      <button
        data-model-zoom="in"
        aria-label={t("model.zoomIn", locale)}
        type="button"
        class="size-10 rounded-control border border-line text-lg hover:border-copper"
      >
        +
      </button>
      <button
        data-model-zoom="out"
        aria-label={t("model.zoomOut", locale)}
        type="button"
        class="size-10 rounded-control border border-line text-lg hover:border-copper"
      >
        −
      </button>
    </div>
    <div class="grid gap-2 sm:grid-cols-2">
      <label class="grid min-w-0 gap-1 text-xs font-semibold text-ink-soft">
        {t("model.variant", locale)}
        <select
          data-model-variant
          disabled={variants.length === 1}
          class="min-h-10 rounded-control border border-line bg-white px-2 text-sm text-ink"
        >
          {variants.map((v) => (
            <option value={v.url} selected={v.selected}>
              {v.label}
            </option>
          ))}
        </select>
      </label>
      {colors.length > 0 && (
        <label class="grid min-w-0 gap-1 text-xs font-semibold text-ink-soft">
          {t("model.color", locale)}
          <select
            data-model-color
            disabled={colors.length === 1}
            class="min-h-10 rounded-control border border-line bg-white px-2 text-sm text-ink"
          >
            {colors.map((c) => (
              <option value={c.hex} selected={c.selected}>
                {c.label}
              </option>
            ))}
          </select>
        </label>
      )}
    </div>
    <a
      data-model-quicklook
      hidden
      rel="ar"
      class="inline-flex min-h-11 items-center rounded-control border border-coffee px-3 font-semibold text-coffee"
    >
      <img src={poster.src} alt="" width="1" height="1" class="sr-only" />
      {t("model.ar", locale)}
    </a>
    <button
      data-model-xr
      hidden
      type="button"
      class="min-h-11 rounded-control border border-coffee px-3 font-semibold text-coffee"
    >
      {t("model.ar", locale)}
    </button>
  </div>
  <noscript>
    <style>
      [data-model-gallery] [data-model-panel],
      [data-model-gallery] [data-model-tab],
      [data-model-gallery] [data-model-start] {
        display: none !important;
      }
      [data-model-gallery] [data-model-panel]:nth-child(2) {
        display: block !important;
      }
    </style>
  </noscript>
</article>
<style>
  [hidden] {
    display: none !important;
  }
</style>
<script>
  import { setupModelGallery } from "../lib/model-gallery";
  for (const gallery of document.querySelectorAll<HTMLElement>(
    "[data-model-gallery]",
  ))
    setupModelGallery(gallery);
</script>
