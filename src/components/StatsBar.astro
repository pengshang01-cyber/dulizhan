---
import type { Locale } from "../i18n/utils";
import { t, localized } from "../i18n/utils";
const { locale = "en" } = Astro.props;
import { display, isTodo, site, type SiteStat } from "../config/site";
import Container from "./Container.astro";

interface Props {
  locale?: Locale;
  stats?: readonly SiteStat[];
}

const { stats = site.stats } = Astro.props;
---

<section
  aria-label={t("site.figures", locale)}
  class="border-y border-line bg-white"
>
  <Container>
    <dl class="stats-grid grid grid-cols-2 lg:grid-cols-4">
      {stats.map(({ value, label }) => (
        <div class="flex min-w-0 flex-col justify-center gap-3 px-3 py-7 text-center sm:px-6 sm:py-9">
          <dt class="order-2 text-[0.625rem] leading-relaxed font-bold tracking-[0.12em] text-ink-soft uppercase sm:text-[0.6875rem]">
            {localized(label, locale)}
          </dt>
          <dd
            class:list={[
              "font-display leading-[1.05] font-normal tracking-[-0.035em] wrap-anywhere text-ink",
              isTodo(value)
                ? "text-[1.375rem] sm:text-[1.75rem]"
                : "text-4xl sm:text-5xl",
            ]}
          >
            {display(value, localized(label, locale))}
          </dd>
        </div>
      ))}
    </dl>
  </Container>
</section>
