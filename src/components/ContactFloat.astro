---
import type { Locale } from "../i18n/utils";
import { site } from "../config/site";
import { confirmedText } from "../lib/placeholders";
import WeChatFloat from "./WeChatFloat.astro";
import WhatsAppFloat from "./WhatsAppFloat.astro";

interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;
const hasWeChat = Boolean(confirmedText(site.wechatId));
---

{locale === "zh" && hasWeChat ? (
  <WeChatFloat locale={locale} />
) : (
  <WhatsAppFloat locale={locale} />
)}
