---
import { Image } from "astro:assets";
import { site } from "../../config/site";
import { resolveSiteImage } from "../../lib/site-images";
import type { Locale } from "../../i18n/utils";
const { locale = "en" } = Astro.props;
import { t } from "../../i18n/utils";
import Container from "../Container.astro";
import SectionHeading from "../SectionHeading.astro";

interface Props {
  locale?: Locale;
  videoId: string;
}

const { videoId } = Astro.props;
const thumbnail =
  resolveSiteImage(site.factoryVideoPoster) ??
  "https://i.ytimg.com/vi/" + videoId + "/hqdefault.jpg";
const thumbnailProps =
  typeof thumbnail === "string"
    ? { src: thumbnail, width: 480, height: 360 }
    : { src: thumbnail, width: 480, height: 360 };
const embed =
  "https://www.youtube-nocookie.com/embed/" + videoId + "?autoplay=1";
---

<section
  id="factory-video"
  aria-labelledby="factory-video-title"
  class="border-b border-line bg-paper py-14 sm:py-20"
>
  <Container>
    <SectionHeading
      eyebrow={t("pages.factoryvideo.a_closer_look", locale)}
      title={t("pages.factoryvideo.inside_the_factory", locale)}
      id="factory-video-title"
    />
    <div class="relative isolate mt-7 aspect-video min-h-[200px] w-full max-w-3xl rounded-panel bg-coffee shadow-panel">
      <button
        type="button"
        data-video-embed={embed}
        data-video-title={t("video.playerTitle", locale)}
        class="relative isolate grid size-full cursor-pointer place-items-center overflow-hidden rounded-panel text-white"
      >
        <Image
          {...thumbnailProps}
          alt=""
          format="webp"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 -z-10 size-full object-cover opacity-65"
        />
        <span
          class="grid size-16 place-items-center rounded-control border border-sand bg-coffee transition-colors hover:bg-coffee-2 motion-reduce:transition-none"
          aria-hidden="true"
        >
          <svg viewBox="0 0 24 24" class="size-7" fill="currentColor">
            <path d="M8 4.9v14.2a.75.75 0 0 0 1.16.63l10.65-7.1a.75.75 0 0 0 0-1.26L9.16 4.27A.75.75 0 0 0 8 4.9Z"></path>
          </svg>
        </span>
        <span class="sr-only">
          {t("pages.factoryvideo.play_factory_video", locale)}
        </span>
      </button>
      <script is:inline>
        (() => {
          const button = document.currentScript?.previousElementSibling;
          if (
            !(button instanceof HTMLButtonElement) ||
            !button.dataset.videoEmbed
          )
            return;
          button.addEventListener(
            "click",
            () => {
              const player = document.createElement("iframe");
              player.src = button.dataset.videoEmbed;
              player.title = button.dataset.videoTitle ?? "";
              player.className = "absolute inset-0 size-full rounded-panel";
              player.allow = "autoplay; encrypted-media; picture-in-picture";
              player.allowFullscreen = true;
              player.referrerPolicy = "strict-origin-when-cross-origin";
              button.replaceWith(player);
              player.focus();
            },
            { once: true },
          );
        })();
      </script>
    </div>
  </Container>
</section>
