# 构建变量：Cloudflare Worker → Settings → Build → Build variables and secrets
# 本地只将这些 PUBLIC_ 项放入 .env；其值会公开到浏览器，不能填写密钥
PUBLIC_GA_ID=
PUBLIC_TURNSTILE_SITE_KEY=

# 运行时配置：Worker → Settings → Variables and Secrets，以 Secret 保存
# 本地仅填入 .dev.vars；不要提交 .env 或 .dev.vars，不要写进源码或 wrangler.jsonc
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=
