---
import { getProducts, inquiryProduct } from "../../lib/products";
import { localePath } from "../../i18n/routing";
import type { Locale } from "../../i18n/utils";
import { t } from "../../i18n/utils";
const { locale = "en" } = Astro.props;
import Button from "../Button.astro";
import Container from "../Container.astro";
import SectionHeading from "../SectionHeading.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
const catalog = (await getProducts()).map(({ data }) =>
  inquiryProduct(data, locale),
);
interface Props {
  locale?: Locale;
}
---

<BaseLayout locale={locale} noindex>
  <Container class="py-12 sm:py-16">
    <SectionHeading
      eyebrow={t("inquiry.eyebrow", locale)}
      title={t("inquiry.title", locale)}
      level={1}
      description={t("inquiry.description", locale)}
    />
    <p
      data-inquiry-status
      aria-live="polite"
      class="mt-6 text-sm text-ink-soft"
    ></p>

    <section
      data-inquiry-empty
      class="mt-6 rounded-panel border border-line bg-white px-6 py-12 text-center sm:py-16"
      aria-labelledby="empty-inquiry-title"
    >
      <h2
        id="empty-inquiry-title"
        class="font-display text-section-title font-normal"
      >
        {t("inquiry.emptyTitle", locale)}
      </h2>
      <p class="mx-auto mt-4 max-w-lg text-sm leading-relaxed text-ink-soft">
        {t("inquiry.emptyDescription", locale)}
      </p>
      <Button href={localePath("/products/", locale)} class="mt-6">
        {t("inquiry.browse", locale)}
      </Button>
    </section>

    <div data-inquiry-filled hidden class="mt-6">
      <div class="mb-5 text-right">
        <Button variant="secondary" data-inquiry-clear>
          {t("inquiry.clear", locale)}
        </Button>
      </div>
      <ul
        data-inquiry-items
        data-inquiry-catalog={JSON.stringify(catalog)}
        aria-label={t("inquiry.selected", locale)}
        class="grid gap-4"
      ></ul>
      <div class="mt-8 border-t border-line pt-7">
        <Button
          href={localePath("/contact/?from=inquiry#quote", locale)}
          data-inquiry-continue
        >
          {t("inquiry.continue", locale)}
        </Button>
      </div>
    </div>

    <noscript>
      <p class="mt-5 text-sm text-ink-soft">{t("inquiry.noscript", locale)}</p>
    </noscript>

    <template id="inquiry-item-template">
      <li
        data-inquiry-item
        class="grid items-start gap-6 rounded-panel border border-line bg-white p-5 sm:p-7 md:grid-cols-[minmax(0,1fr)_14rem_auto]"
      >
        <div class="min-w-0">
          <p
            data-inquiry-sku
            hidden
            class="mb-3 text-xs leading-relaxed tracking-[0.12em] wrap-anywhere text-muted uppercase"
          ></p>
          <h2 class="font-display text-card-title font-normal wrap-anywhere">
            <a data-inquiry-product class="hover:text-copper"></a>
          </h2>
        </div>
        <div class="min-w-0">
          <label
            data-inquiry-quantity-label
            class="block text-xs font-bold tracking-[0.06em] uppercase"
          >
            {t("inquiry.quantityOptional", locale)}
          </label>
          <div class="mt-2 flex items-center gap-3">
            <input
              data-inquiry-quantity
              type="text"
              inputmode="numeric"
              placeholder={t("inquiry.quantityPlaceholder", locale)}
              class="w-32 text-sm"
            />
            <span class="text-sm text-ink-soft">
              {t("inquiry.pcs", locale)}
            </span>
          </div>
          <p data-inquiry-quantity-note class="mt-2 text-sm text-ink-soft">
            {t("inquiry.toDiscuss", locale)}
          </p>
          <p
            data-inquiry-quantity-error
            hidden
            class="mt-2 text-sm text-copper-dark"
          >
            {t("inquiry.quantityError", locale)}
          </p>
        </div>
        <Button
          variant="ghost"
          data-inquiry-remove
          class="justify-self-start md:justify-self-end"
        >
          {t("inquiry.remove", locale)}
        </Button>
      </li>
    </template>
  </Container>
</BaseLayout>

<script>
  import { productHref } from "../../i18n/routing";
  import {
    readInquiryCatalog,
    inquiryDisplayItem,
  } from "../../lib/inquiry-view";
  import { t } from "../../i18n/utils";
  const locale = document.documentElement.lang === "zh-CN" ? "zh" : "en";
  import {
    clearItems,
    getItems,
    INQUIRY_CHANGE_EVENT,
    parseQuantityInput,
    removeItem,
    setQuantity,
    type InquiryItem,
  } from "../../lib/inquiry";

  const empty = document.querySelector<HTMLElement>("[data-inquiry-empty]");
  const filled = document.querySelector<HTMLElement>("[data-inquiry-filled]");
  const list = document.querySelector<HTMLUListElement>("[data-inquiry-items]");
  const status = document.querySelector<HTMLElement>("[data-inquiry-status]");
  const template = document.querySelector<HTMLTemplateElement>(
    "#inquiry-item-template",
  );

  const catalog = readInquiryCatalog(list?.dataset.inquiryCatalog);

  function createRow(item: InquiryItem): HTMLLIElement | undefined {
    const row = template?.content.firstElementChild?.cloneNode(true) as
      HTMLLIElement | undefined;
    if (!row) return;
    row.dataset.slug = item.slug;
    const input = row.querySelector<HTMLInputElement>(
      "[data-inquiry-quantity]",
    );
    const label = row.querySelector<HTMLLabelElement>(
      "[data-inquiry-quantity-label]",
    );
    const error = row.querySelector<HTMLElement>(
      "[data-inquiry-quantity-error]",
    );
    const note = row.querySelector<HTMLElement>("[data-inquiry-quantity-note]");
    if (input && label && error && note) {
      input.id = `inquiry-quantity-${item.slug}`;
      label.htmlFor = input.id;
      error.id = `${input.id}-error`;
      note.id = `${input.id}-note`;
      input.setAttribute("aria-describedby", `${note.id} ${error.id}`);
      input.addEventListener("input", () => {
        const quantity = parseQuantityInput(input.value);
        const valid = quantity !== undefined;
        input.setCustomValidity(
          valid ? "" : t("inquiry.quantityError", locale),
        );
        input.setAttribute("aria-invalid", String(!valid));
        error.hidden = valid;
        note.hidden = quantity !== null;
        if (quantity !== undefined) setQuantity(item.slug, quantity);
      });
    }
    const remove = row.querySelector<HTMLButtonElement>(
      "[data-inquiry-remove]",
    );
    remove?.setAttribute(
      "aria-label",
      t("inquiry.removeProduct", locale, {
        title: item.title,
      }),
    );
    remove?.addEventListener("click", () => removeItem(item.slug));
    return row;
  }

  function renderInquiry() {
    if (!list || !empty || !filled) return;
    const items = getItems().map((item) => inquiryDisplayItem(item, catalog));
    empty.hidden = items.length > 0;
    filled.hidden = items.length === 0;
    if (status) {
      const text = items.length
        ? t(
            items.length === 1 ? "inquiry.countOne" : "inquiry.countMany",
            locale,
            { count: items.length },
          )
        : "";
      if (status.textContent !== text) status.textContent = text;
    }
    const existing = new Map(
      [...list.querySelectorAll<HTMLLIElement>("[data-inquiry-item]")].map(
        (row) => [row.dataset.slug, row],
      ),
    );
    const selected = new Set(items.map(({ slug }) => slug));
    for (const [slug, row] of existing) {
      if (!slug || !selected.has(slug)) row.remove();
    }
    for (const item of items) {
      const row = existing.get(item.slug) ?? createRow(item);
      if (!row) continue;
      const title = row.querySelector<HTMLAnchorElement>(
        "[data-inquiry-product]",
      );
      const sku = row.querySelector<HTMLElement>("[data-inquiry-sku]");
      const input = row.querySelector<HTMLInputElement>(
        "[data-inquiry-quantity]",
      );
      if (title) {
        title.textContent = item.title;
        title.href = productHref(item, locale);
      }
      if (sku) {
        sku.hidden = !item.sku;
        sku.textContent = item.sku
          ? t("inquiry.sku", locale, { sku: item.sku })
          : "";
      }
      // 数量变化保留已有行及当前输入焦点，不整体重建 DOM。
      if (input && document.activeElement !== input) {
        input.value = item.quantity === null ? "" : String(item.quantity);
        input.setCustomValidity("");
        input.setAttribute("aria-invalid", "false");
        const error = row.querySelector<HTMLElement>(
          "[data-inquiry-quantity-error]",
        );
        if (error) error.hidden = true;
        const note = row.querySelector<HTMLElement>(
          "[data-inquiry-quantity-note]",
        );
        if (note) note.hidden = item.quantity !== null;
      }
      if (!row.isConnected) list.append(row);
    }
  }

  document
    .querySelector<HTMLButtonElement>("[data-inquiry-clear]")
    ?.addEventListener("click", clearItems);
  document
    .querySelector<HTMLAnchorElement>("[data-inquiry-continue]")
    ?.addEventListener("click", (event) => {
      const invalid = [
        ...document.querySelectorAll<HTMLInputElement>(
          "[data-inquiry-quantity]",
        ),
      ].find((input) => !input.checkValidity());
      if (!invalid) return;
      // 先修正本页未保存的输入，避免联系页摘要展示上一次的数量。
      event.preventDefault();
      invalid.reportValidity();
      invalid.focus();
    });
  window.addEventListener(INQUIRY_CHANGE_EVENT, renderInquiry);
  window.addEventListener("pageshow", renderInquiry);
  renderInquiry();
</script>
