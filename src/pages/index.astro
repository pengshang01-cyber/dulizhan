---
import { site } from "../config/site";
import "../styles/global.css";

const companyName = site.companyName.startsWith("TODO_")
  ? "[TODO: company name]"
  : site.companyName;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{companyName}</title>
  </head>
  <body class="min-h-screen bg-stone-50 text-stone-900 antialiased">
    <main class="mx-auto max-w-3xl px-6 py-16">
      <h1 class="text-3xl font-semibold break-words">{companyName}</h1>
      <p class="mt-3 text-stone-700">Cupcake Liners and Baking Cups</p>
    </main>
  </body>
</html>
