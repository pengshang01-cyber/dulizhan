---
const current = Astro.url.pathname.replace(/\/?$/, "/") === "/inquiry/";
---

<a
  href="/inquiry/"
  data-inquiry-link
  aria-label="Your inquiry list"
  aria-current={current ? "page" : undefined}
  class="relative inline-flex size-11 shrink-0 items-center justify-center gap-1.5 rounded-control border border-transparent text-ink-soft hover:text-copper aria-[current=page]:border-copper aria-[current=page]:text-copper lg:w-auto lg:px-2"
>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    class="size-5 lg:hidden"
  >
    <path
      d="M8 4H5v17h14V4h-3M8 3h8v4H8zM8 11h8M8 15h8"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
  </svg>
  <span class="sr-only text-xs font-semibold lg:not-sr-only">Inquiry</span>
  <span
    hidden
    data-inquiry-count
    aria-hidden="true"
    class="absolute top-0 right-0 min-w-4 rounded-control bg-coffee px-1 text-center text-[0.625rem] leading-4 font-bold text-cream lg:static"
  ></span>
</a>

<script>
  import { getItems, INQUIRY_CHANGE_EVENT } from "../lib/inquiry";

  function syncInquiryLinks() {
    const count = getItems().length;
    for (const link of document.querySelectorAll<HTMLAnchorElement>(
      "[data-inquiry-link]",
    )) {
      link.setAttribute(
        "aria-label",
        count
          ? `Your inquiry list, ${count} ${count === 1 ? "product" : "products"}`
          : "Your inquiry list",
      );
      const badge = link.querySelector<HTMLElement>("[data-inquiry-count]");
      if (badge) {
        badge.textContent = String(count);
        badge.hidden = count === 0;
      }
    }
  }

  window.addEventListener(INQUIRY_CHANGE_EVENT, syncInquiryLinks);
  window.addEventListener("pageshow", syncInquiryLinks);
  syncInquiryLinks();
</script>
