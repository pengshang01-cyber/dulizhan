---
import type { GetStaticPaths } from "astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import Container from "../../../components/Container.astro";
import ProductCard from "../../../components/ProductCard.astro";
import ProductCategoryNav from "../../../components/ProductCategoryNav.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import { localized, t } from "../../../i18n/utils";
import {
  getProducts,
  getVisibleCategories,
  type Product,
  type ProductCategory,
} from "../../../lib/products";
import BaseLayout from "../../../layouts/BaseLayout.astro";
export const getStaticPaths = (async () => {
  const products = await getProducts();
  return (await getVisibleCategories()).map((category) => ({
    params: { category: category.id },
    props: {
      category,
      products: products.filter(({ data }) => data.category === category.id),
    },
  }));
}) satisfies GetStaticPaths;
interface Props {
  category: ProductCategory;
  products: Product[];
}
const { category, products } = Astro.props;
const locale = "en";
const label = localized(category.label, locale);
const summary = localized(category.summary, locale);
---

<BaseLayout
  title={t("categories.pageTitle", locale, { label })}
  description={summary}
>
  <Container class="py-8 sm:py-12">
    <Breadcrumbs
      items={[
        { label: t("breadcrumbs.home", locale), href: "/" },
        { label: t("breadcrumbs.products", locale), href: "/products/" },
        { label },
      ]}
    />
    <div class="mt-8 max-w-3xl">
      <SectionHeading
        eyebrow={t("products.collectionEyebrow", locale)}
        title={label}
        level={1}
        description={summary}
      />
    </div>
    <div class="mt-8 border-y border-line py-5">
      <ProductCategoryNav current={category.id} />
    </div>
    <div
      class="mt-9 grid gap-5 sm:grid-cols-2 lg:grid-cols-3"
      aria-label={t("categories.productList", locale, { label })}
    >
      {products.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>
  </Container>
</BaseLayout>
