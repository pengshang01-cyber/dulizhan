---
import Container from "./Container.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  title: string;
  description?: string;
  headingId?: string;
}

const { title, description, headingId } = Astro.props;
---

<section class="py-14 sm:py-20 lg:py-24">
  <Container>
    <SectionHeading
      eyebrow="Factory direct"
      title={title}
      description={description}
      id={headingId}
      level={1}
    />
    <slot />
  </Container>
</section>
